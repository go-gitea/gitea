{{$page := or $.Page ctx.RootData.Page}}
{{$paginationLink := $.Link}}
{{if eq $paginationLink nil}}{{$paginationLink = ctx.RootData.Link}}{{end}}
{{if eq $paginationLink AppSubUrl}}{{$paginationLink = print $paginationLink "/"}}{{end}}
{{$pageLink := print $paginationLink "?" $page.GetParams}}
{{$paginator := $page.Paginator}}
{{if and $paginator (or (eq $paginator.TotalPages -1) (gt $paginator.TotalPages 1))}}
	{{$unknownTotal := eq $paginator.TotalPages -1}}
	{{$textPrevious := ctx.Locale.Tr "repo.issues.previous"}}
	{{$textNext := ctx.Locale.Tr "repo.issues.next"}}
	<div class="center page buttons">
		<nav class="ui borderless pagination menu {{if $unknownTotal}}pagination-prev-next{{end}}" aria-label="{{ctx.Locale.Tr "aria.pagination"}}">
			<a class="{{if not $paginator.HasPrevious}}disabled {{end}}item flex-text-inline" {{if $paginator.HasPrevious}}href="{{QueryBuild $pageLink "page" $paginator.Previous}}"{{else}}role="link" aria-disabled="true"{{end}} {{if not $unknownTotal}}aria-label="{{$textPrevious}}" data-tooltip-content="{{$textPrevious}}"{{end}}>
				{{svg "octicon-chevron-left"}}{{if $unknownTotal}}{{$textPrevious}}{{end}}
			</a>
			{{range $num := $paginator.Pages}}
				{{if eq $num -1}}
					<span class="disabled item">…</span>
				{{else if eq $num $paginator.Current}}
					<span class="{{if not $unknownTotal}}active {{end}}item" aria-current="page">{{$num}}</span>
				{{else}}
					<a class="item" href="{{QueryBuild $pageLink "page" $num}}">{{$num}}</a>
				{{end}}
			{{end}}
			<a class="{{if not $paginator.HasNext}}disabled {{end}}item flex-text-inline" {{if $paginator.HasNext}}href="{{QueryBuild $pageLink "page" $paginator.Next}}"{{else}}role="link" aria-disabled="true"{{end}} {{if not $unknownTotal}}aria-label="{{$textNext}}" data-tooltip-content="{{$textNext}}"{{end}}>
				{{if $unknownTotal}}{{$textNext}}{{end}}{{svg "octicon-chevron-right"}}
			</a>
		</nav>
	</div>
{{end}}
