{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "organization settings ssh-keys")}}

<div class="ui segments org-setting-content">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "settings.managed_ssh_title"}}
	</h4>
	<div class="ui attached segment">
		<div class="ui form">
			<div class="field">
				<label>{{ctx.Locale.Tr "settings.managed_ssh_description"}}</label>
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "settings.managed_ssh_current_key"}}</label>
				<div class="ui action input">
					<input id="ssh-public-key-content" class="js-ssh-key-content" value="{{.SSHKeypair.PublicKey}}" readonly>
					<button type="button" class="ui compact button" data-clipboard-target="#ssh-public-key-content" data-tooltip-content="{{ctx.Locale.Tr "copy"}}">
						{{svg "octicon-copy" 14}}
					</button>
				</div>
				<small class="text grey">{{ctx.Locale.Tr "settings.managed_ssh_fingerprint"}}: {{.SSHKeypair.Fingerprint}}</small>
			</div>
			<div class="field">
				<form action="{{.OrgLink}}/settings/ssh_keys/regenerate" method="post">
					<button class="ui primary button" type="submit">{{ctx.Locale.Tr "settings.managed_ssh_regenerate"}}</button>
				</form>
			</div>
			<div class="field">
				<div class="ui info message">
					<i class="info icon"></i>
					{{ctx.Locale.Tr "settings.managed_ssh_documentation"}}
				</div>
			</div>
		</div>
	</div>
</div>

{{template "org/settings/layout_footer" .}}
