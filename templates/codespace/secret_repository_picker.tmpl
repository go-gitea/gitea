<div class="field codespace-secret-repository-picker" data-global-init="initCodespaceSecretRepositoryPicker" data-search-url="{{.SearchURL}}"
	data-no-results="{{ctx.Locale.Tr "search.no_results"}}" data-search-error="{{ctx.Locale.Tr "error503"}}">
	<label>{{ctx.Locale.Tr "codespace.secret_repository_access"}}</label>
	<div class="ui toggle checkbox">
		<input id="{{.ID}}-all" class="codespace-secret-all-repositories" type="checkbox" name="all_repositories">
		<label for="{{.ID}}-all">{{ctx.Locale.Tr "codespace.secret_all_repositories"}}</label>
	</div>
	<div class="codespace-secret-selected-scope tw-mt-3">
		<select class="ui fluid multiple search selection dropdown custom codespace-secret-repositories" name="repository_ids" multiple aria-label="{{ctx.Locale.Tr "codespace.secret_repository_access"}}">
			<option value="">{{ctx.Locale.Tr "search.repo_kind"}}</option>
		</select>
	</div>
</div>
