<div class="field codespace-secret-repository-picker" data-global-init="initCodespaceSecretRepositoryPicker" data-search-url="{{.SearchURL}}" data-remove-label="{{ctx.Locale.Tr "remove"}}">
	<label>{{ctx.Locale.Tr "codespace.secret_repository_access"}}</label>
	<div class="ui toggle checkbox">
		<input id="{{.ID}}-all" class="codespace-secret-all-repositories" type="checkbox" name="all_repositories">
		<label for="{{.ID}}-all">{{ctx.Locale.Tr "codespace.secret_all_repositories"}}</label>
	</div>
	<div class="codespace-secret-selected-scope tw-mt-3">
		<div class="ui search codespace-secret-repository-search">
			<div class="ui input tw-w-full"><input class="prompt" type="search" placeholder="owner/repository" autocomplete="off"></div>
		</div>
		<div class="ui relaxed divided list codespace-secret-selected-repositories"></div>
	</div>
</div>
