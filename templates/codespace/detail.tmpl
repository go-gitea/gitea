{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content codespace codespace-detail-page codespace-detail-tab-{{.CodespaceTab}}" data-codespace-tab-explicit="{{if .CodespaceTabExplicit}}true{{else}}false{{end}}">
	<div class="ui fluid container codespace-detail-container">
		{{template "base/alert" .}}
		<a class="codespace-back-link tw-inline-flex tw-items-center tw-self-start tw-gap-1" href="{{AppSubUrl}}/-/codespaces">{{svg "octicon-arrow-left" 14}} {{ctx.Locale.Tr "codespace.back_to_list"}}</a>
		{{if .OpenEndpointError}}<div class="ui warning message">{{ctx.Locale.Tr "codespace.open.unavailable"}}</div>{{end}}
		{{template "codespace/open_modal" .}}
		{{template "codespace/settings_modal" .}}
		{{template "codespace/state" .}}
		{{if eq .CodespaceTab "logs"}}
			<div class="codespace-detail-layout">
				<section class="codespace-log-panel">
					<div class="codespace-log-header">
						<h3 class="codespace-log-title flex-text-block">{{svg "octicon-terminal" 16}}{{ctx.Locale.Tr "codespace.operation_log"}}<span class="codespace-log-loading tw-hidden" data-codespace-log-loading>{{ctx.Locale.Tr "loading"}}</span></h3>
						<div class="ui compact top right pointing dropdown icon button jump tw-shrink-0" data-tooltip-content="{{ctx.Locale.Tr "more_items"}}">
							{{svg "octicon-kebab-horizontal"}}
							<div class="menu codespace-log-menu">
								<button class="item" type="button" data-codespace-log-toggle-timestamps aria-pressed="false"><span class="codespace-log-menu-check tw-invisible" data-codespace-log-timestamp-check>{{svg "octicon-check" 16}}</span>{{ctx.Locale.Tr "show_timestamps"}}</button>
								<button class="item" type="button" data-codespace-log-fullscreen data-enter-label="{{ctx.Locale.Tr "codespace.enter_fullscreen"}}" data-exit-label="{{ctx.Locale.Tr "codespace.exit_fullscreen"}}">{{svg "octicon-screen-full" 16}}<span>{{ctx.Locale.Tr "codespace.enter_fullscreen"}}</span></button>
								<a class="item" href="{{AppSubUrl}}/-/codespaces/{{.Codespace.UUID}}/logs/download">{{svg "octicon-download" 16}}{{ctx.Locale.Tr "codespace.download_logs"}}</a>
							</div>
						</div>
					</div>
					<div id="codespace-log-view" class="console codespace-log-view" role="log" aria-label="{{ctx.Locale.Tr "codespace.operation_log"}}"
						data-log-url="{{AppSubUrl}}/-/codespaces/{{.Codespace.UUID}}/logs" data-log-next-offset="0" data-log-eof="false"
						data-log-refresh-after-ms="{{.Codespace.RefreshAfterMillis}}" data-log-line-count="0" data-log-empty="true"
						data-log-error-message="{{ctx.Locale.Tr "codespace.log_load_failed"}}">
						<div class="codespace-log-empty" data-log-empty-message>{{ctx.Locale.Tr "codespace.no_log_lines"}}</div>
					</div>
				</section>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
