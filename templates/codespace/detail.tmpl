{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content codespace codespace-detail-page codespace-detail-tab-{{.CodespaceTab}}" data-codespace-tab-explicit="{{if .CodespaceTabExplicit}}true{{else}}false{{end}}">
	<div class="ui fluid container codespace-detail-container">
		{{template "base/alert" .}}
		<a class="codespace-back-link tw-inline-flex tw-items-center tw-self-start tw-gap-1" href="{{.CodespaceListReturnTo}}">{{svg "octicon-arrow-left" 14}} {{ctx.Locale.Tr "codespace.back_to_list"}}</a>
		{{template "codespace/refresh_notice" .}}
		{{if .OpenEndpointError}}<div class="ui warning message">{{ctx.Locale.Tr "codespace.open.unavailable"}}</div>{{end}}
		{{template "codespace/open_modal" .}}
		{{template "codespace/settings_modal" .}}
		{{template "codespace/state" .}}
		{{if eq .CodespaceTab "logs"}}
			<div class="codespace-detail-layout">
				<section class="codespace-log-panel">
					<div class="codespace-log-header">
						<h3 class="codespace-log-title flex-text-block">{{svg "octicon-terminal" 16}}{{ctx.Locale.Tr "codespace.operation_log"}}<span class="codespace-log-loading tw-invisible" data-codespace-log-loading>{{ctx.Locale.Tr "loading"}}</span></h3>
						<a class="ui small basic button tw-shrink-0" href="{{AppSubUrl}}/-/codespaces/{{.Codespace.ID}}/logs/download">{{svg "octicon-download" 16}}{{ctx.Locale.Tr "codespace.download_logs"}}</a>
					</div>
					<div id="codespace-log-view" class="console codespace-log-view" role="log" tabindex="0" aria-label="{{ctx.Locale.Tr "codespace.operation_log"}}"
						data-log-url="{{AppSubUrl}}/-/codespaces/{{.Codespace.ID}}/logs" data-log-next-offset="0"
						data-log-refresh-after-ms="{{.Codespace.RefreshAfterMillis}}">
						<div data-log-empty-message>{{ctx.Locale.Tr "codespace.no_log_lines"}}</div>
						<pre data-log-content></pre>
					</div>
					<div class="tw-hidden tw-p-3" role="status" data-log-error>
						{{ctx.Locale.Tr "codespace.log_load_failed"}}
						<button type="button" class="ui small basic button" data-log-retry>{{ctx.Locale.Tr "retry"}}</button>
					</div>
				</section>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
