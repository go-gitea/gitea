{{$availableSecrets := .AvailableSecrets}}
{{with .Field}}
<div class="item" data-codespace-secret-row>
	<div class="item-main">
		<div class="fields">
			<div class="field tw-flex-auto tw-min-w-0">
				<label>{{ctx.Locale.Tr "name"}}</label>
				{{if .Recommended}}
					<input type="text" name="secret_name" value="{{.Name}}" readonly>
				{{else}}
					<select class="ui fluid search selection dropdown ellipsis-text-items custom" name="secret_name" required>
						<option value="">{{ctx.Locale.Tr "codespace.secret_name_placeholder"}}</option>
						{{if and .Name (not .Available)}}<option value="{{.Name}}" selected>{{.Name}}</option>{{end}}
						{{$name := .Name}}
						{{range $availableSecrets}}<option value="{{.}}"{{if eq . $name}} selected{{end}}>{{.}}</option>{{end}}
					</select>
				{{end}}
				{{if .Description}}<div class="help">{{.Description}}</div>{{end}}
			</div>
			<div class="field tw-flex-auto tw-min-w-0">
				<label>{{ctx.Locale.Tr "codespace.source"}}</label>
				<select class="ui fluid selection dropdown custom" name="secret_source">
					<option value="none"{{if eq .Source "none"}} selected{{end}}>{{ctx.Locale.Tr "codespace.secret_source_none"}}</option>
					<option value="saved"{{if eq .Source "saved"}} selected{{end}}{{if not .Available}} disabled{{end}}>{{ctx.Locale.Tr "codespace.secret_source_saved"}}</option>
					<option value="custom"{{if eq .Source "custom"}} selected{{end}}>{{ctx.Locale.Tr "codespace.secret_source_custom"}}</option>
				</select>
			</div>
		</div>
		<div class="field{{if ne .Source "custom"}} tw-hidden{{end}}" data-codespace-secret-value>
			<label>{{ctx.Locale.Tr "value"}}</label>
			<textarea name="secret_value" rows="2" autocomplete="off" spellcheck="false" placeholder="{{ctx.Locale.Tr "codespace.secret_optional_value"}}"></textarea>
		</div>
	</div>
	{{if not .Recommended}}
		<div class="item-trailing">
			<button type="button" class="btn interact-bg tw-p-2" data-codespace-secret-remove aria-label="{{ctx.Locale.Tr "remove"}}" data-tooltip-content="{{ctx.Locale.Tr "remove"}}">{{svg "octicon-trash"}}</button>
		</div>
	{{end}}
</div>
{{end}}
