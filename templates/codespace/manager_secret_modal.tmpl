<div class="ui small modal codespace-modal" data-global-init="initCodespaceManagerSecretModal" data-response-error="{{ctx.Locale.Tr "codespace.manager_secret_response_error"}}">
	<div class="header">{{ctx.Locale.Tr "codespace.manager_credentials"}}</div>
	<form class="ignore-dirty" method="post" action="{{.ActionBase}}/{{.Manager.ID}}/secret">
		{{.CsrfTokenHtml}}
	<div class="content">
		<p>{{.Manager.Name}} ({{ctx.Locale.Tr "codespace.manager_id"}} {{.Manager.ID}})</p>
		<p data-secret-confirm>{{ctx.Locale.Tr "codespace.manager_secret_reset_notice"}}</p>
		<div data-secret-result hidden>
			<p>{{ctx.Locale.Tr "codespace.manager_secret_copy_notice"}}</p>
			<div class="ui fluid action input">
				<input id="manager-secret-value" type="text" readonly autocomplete="off" aria-label="{{ctx.Locale.Tr "codespace.manager_credentials"}}">
				<button type="button" class="ui icon button" data-clipboard-target="#manager-secret-value" aria-label="{{ctx.Locale.Tr "copy"}}">{{svg "octicon-copy"}}</button>
			</div>
		</div>
	</div>
	<div class="actions">
			<button type="button" class="ui cancel button">{{svg "octicon-x"}} {{ctx.Locale.Tr "close"}}</button>
			<button type="submit" class="ui primary button" data-secret-submit>{{svg "octicon-check"}} {{ctx.Locale.Tr "codespace.manager_secret_reset"}}</button>
	</div>
	</form>
</div>
