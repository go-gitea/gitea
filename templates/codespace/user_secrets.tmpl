{{template "user/settings/layout_head" (dict "pageClass" "user settings codespace secrets")}}
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "codespace.secrets"}}
		<div class="ui right">
			<button class="ui primary tiny button show-modal codespace-secret-create-button" data-modal="#codespace-secret-create-modal">
				{{ctx.Locale.Tr "secrets.add_secret"}}
			</button>
		</div>
	</h4>
	<div class="ui attached segment">
		{{if .CodespaceSecrets}}
			<div class="flex-divided-list items-with-main">
				{{range .CodespaceSecrets}}
					<div class="item tw-items-center codespace-secret-item">
						<div class="item-leading">{{svg "octicon-key" 32}}</div>
						<div class="item-main">
							<div class="item-title">{{.Name}}</div>
							<div class="item-body">
								{{if .AllRepositories}}
									{{ctx.Locale.Tr "codespace.secret_all_repositories"}}
								{{else if .Repositories}}
									{{ctx.Locale.Tr "codespace.secret_repository_count" (len .Repositories)}}
								{{else}}
									{{ctx.Locale.Tr "codespace.secret_no_repositories"}}
								{{end}}
							</div>
							<div class="item-body color-text-light-2">{{ctx.Locale.Tr "codespace.secret_value_hidden"}} · {{DateUtils.AbsoluteShort .UpdatedUnix}}</div>
							<div class="tw-hidden codespace-secret-repository-data">
								{{range .Repositories}}<span data-repository-id="{{.ID}}" data-repository-name="{{.FullName}}"></span>{{end}}
							</div>
						</div>
						<div class="item-trailing">
							<button class="btn interact-bg tw-p-2 show-modal" data-modal="#codespace-secret-value-modal"
								data-modal-form.url="{{AppSubUrl}}/user/settings/codespaces/secrets/{{.ID}}/value"
								data-modal-secret-value-name="{{.Name}}" data-tooltip-content="{{ctx.Locale.Tr "codespace.secret_replace_value"}}">
								{{svg "octicon-pencil"}}
							</button>
							<button class="btn interact-bg tw-p-2 show-modal codespace-secret-access-button" data-modal="#codespace-secret-access-modal"
								data-modal-form.url="{{AppSubUrl}}/user/settings/codespaces/secrets/{{.ID}}/access"
								data-modal-secret-access-name="{{.Name}}" data-modal-secret-access-all.checked="{{.AllRepositories}}"
								data-tooltip-content="{{ctx.Locale.Tr "codespace.secret_repository_access"}}">
								{{svg "octicon-repo"}}
							</button>
							<button class="btn interact-bg tw-p-2 link-action" data-url="{{AppSubUrl}}/user/settings/codespaces/secrets/{{.ID}}/delete"
								data-modal-confirm="{{ctx.Locale.Tr "codespace.secret_delete_confirm" .Name}}" data-tooltip-content="{{ctx.Locale.Tr "remove"}}">
								{{svg "octicon-trash"}}
							</button>
						</div>
					</div>
				{{end}}
			</div>
		{{else}}
			{{ctx.Locale.Tr "codespace.no_secrets"}}
		{{end}}
	</div>

	<div class="ui small modal codespace-secret-modal" id="codespace-secret-create-modal">
		<div class="header">{{ctx.Locale.Tr "secrets.add_secret"}}</div>
		<form class="ui form form-fetch-action" method="post" action="{{AppSubUrl}}/user/settings/codespaces/secrets">
			{{.CsrfTokenHtml}}
			<div class="content">
				<div class="field">
					<label for="codespace-secret-name">{{ctx.Locale.Tr "name"}}</label>
					<input id="codespace-secret-name" name="name" required maxlength="255" placeholder="DATABASE_PASSWORD" autocomplete="off" autofocus>
				</div>
				<div class="field">
					<label for="codespace-secret-value">{{ctx.Locale.Tr "value"}}</label>
					<textarea id="codespace-secret-value" name="value" required rows="3" autocomplete="new-password"></textarea>
				</div>
				<div class="ui divider"></div>
				{{template "codespace/secret_repository_picker" (dict "ID" "codespace-secret-create" "SearchURL" (printf "%s/user/settings/codespaces/secrets/repositories" AppSubUrl))}}
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
	</div>

	<div class="ui tiny modal codespace-secret-modal" id="codespace-secret-value-modal">
		<div class="header">{{ctx.Locale.Tr "codespace.secret_replace_value"}}</div>
		<form class="ui form form-fetch-action" method="post">
			{{.CsrfTokenHtml}}
			<div class="content">
				<div class="field">
					<label>{{ctx.Locale.Tr "name"}}</label>
					<div class="codespace-secret-modal-name"><code id="secret-value-name"></code></div>
				</div>
				<div class="field">
					<label for="codespace-secret-new-value">{{ctx.Locale.Tr "codespace.secret_new_value"}}</label>
					<textarea id="codespace-secret-new-value" name="value" required rows="3" autocomplete="new-password"></textarea>
				</div>
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
	</div>

	<div class="ui small modal codespace-secret-modal" id="codespace-secret-access-modal">
		<div class="header">{{ctx.Locale.Tr "codespace.secret_repository_access"}}</div>
		<form class="ui form form-fetch-action" method="post">
			{{.CsrfTokenHtml}}
			<div class="content">
				<div class="field">
					<label>{{ctx.Locale.Tr "name"}}</label>
					<div class="codespace-secret-modal-name"><code id="secret-access-name"></code></div>
				</div>
				<div class="ui divider"></div>
				{{template "codespace/secret_repository_picker" (dict "ID" "codespace-secret-access" "SearchURL" (printf "%s/user/settings/codespaces/secrets/repositories" AppSubUrl))}}
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
	</div>
{{template "user/settings/layout_footer" .}}
