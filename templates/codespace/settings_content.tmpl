<div class="codespace-manager-container">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "codespace.managers"}} ({{ctx.Locale.Tr "admin.total" .ManagerTotal}})
		<div class="ui right">
			<div class="ui top right pointing dropdown jump">
				<button class="ui primary tiny button">
					{{ctx.Locale.Tr "codespace.new_manager"}}
					{{svg "octicon-triangle-down" 14 "dropdown icon"}}
				</button>
				<div class="menu">
					<div class="header">{{ctx.Locale.Tr "codespace.registration_token"}}</div>
					<div class="ui action input">
						<input type="text" value="{{.ManagerSettings.RegistrationToken}}" readonly>
						<button class="ui basic label button" aria-label="{{ctx.Locale.Tr "copy"}}" data-clipboard-text="{{.ManagerSettings.RegistrationToken}}">
							{{svg "octicon-copy" 14}}
						</button>
					</div>
					<div class="divider"></div>
					<div class="item">
						<a class="link-action" data-url="{{$.ActionBase}}/reset_registration_token" data-modal-confirm="{{ctx.Locale.Tr "codespace.reset_registration_token_confirm"}}">
							{{ctx.Locale.Tr "codespace.reset_registration_token"}}
						</a>
					</div>
				</div>
			</div>
		</div>
	</h4>
	{{if .ManagerSettings.Managers}}
		<div class="ui attached table segment">
			<table class="ui very basic table unstackable">
				<thead>
					<tr>
						<th>{{ctx.Locale.Tr "name"}}</th>
						<th>{{ctx.Locale.Tr "status"}}</th>
						{{if .IsSiteManagerSettings}}<th>{{ctx.Locale.Tr "codespace.user"}}</th>{{end}}
						<th>{{ctx.Locale.Tr "codespace.tags"}}</th>
						<th>{{ctx.Locale.Tr "codespace.last_online"}}</th>
						<th>{{ctx.Locale.Tr "codespace.bound_codespaces"}}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{{range .ManagerSettings.Managers}}
						<tr>
							<td>
								<a href="{{$.ActionBase}}/{{.ID}}">{{.Name}}</a>
								{{if .Version}}<div class="tw-text-text-light-2">{{ctx.Locale.Tr "version"}} {{.Version}}</div>{{end}}
							</td>
							<td><span class="ui label codespace-state-label codespace-state-{{.RuntimeDisplayState}}">{{ctx.Locale.Tr (print "codespace.manager_status." .RuntimeDisplayState)}}</span></td>
							{{if $.IsSiteManagerSettings}}<td>{{.UserDisplayName}}</td>{{end}}
							<td>
								{{if .Environments}}
									<span class="flex-text-inline tw-flex-wrap">{{range .Environments}}<span class="ui label">{{.Tag}}</span>{{end}}</span>
								{{else}}
									<span class="tw-text-text-light-2">{{ctx.Locale.Tr "codespace.not_declared"}}</span>
								{{end}}
							</td>
							<td>{{if .LastOnlineUnix}}{{DateUtils.TimeSince .LastOnlineUnix}}{{else}}{{ctx.Locale.Tr "never"}}{{end}}</td>
							<td>{{.BoundCodespaces}}</td>
							<td class="right aligned">
								<a class="btn interact-bg tw-p-2" href="{{$.ActionBase}}/{{.ID}}" data-tooltip-content="{{ctx.Locale.Tr "edit"}}" aria-label="{{ctx.Locale.Tr "edit"}}">{{svg "octicon-pencil"}}</a>
							</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>
	{{else}}
		<div class="ui attached segment tw-text-center">{{ctx.Locale.Tr "codespace.no_managers"}}</div>
	{{end}}

	{{if .IsSiteManagerSettings}}
		<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "codespace.unassigned_codespaces"}} ({{.CodespaceTotal}})</h4>
		{{template "codespace/manager_codespaces" .}}
	{{end}}
</div>
