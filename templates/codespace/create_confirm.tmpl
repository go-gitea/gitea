{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository file list codespace-create-page">
	{{template "repo/header" .}}
	<div class="ui container medium-width">
		{{template "base/alert" .}}
		<h3 class="ui top attached header">
			{{svg "octicon-codespaces" 20}}
			{{ctx.Locale.Tr "codespace.confirm_create"}}
		</h3>
		{{if not .CreatePlan.Environments}}
			<div class="ui attached segment">
				<div class="ui warning message">
					<div class="header">{{ctx.Locale.Tr "codespace.create_unavailable"}}</div>
					<p>{{ctx.Locale.Tr "codespace.environment_unavailable"}}</p>
				</div>
				{{template "codespace/create_source" .}}
			</div>
			<div class="ui bottom attached segment tw-flex tw-justify-end tw-gap-2">
				<a class="ui button" href="{{.RepoLink}}">{{ctx.Locale.Tr "cancel"}}</a>
			</div>
		{{else}}
			<form id="codespace-confirm-create" class="ui form" method="post" action="{{.RepoLink}}/codespaces" data-codespace-create-form>
				{{.CsrfTokenHtml}}
				<input type="hidden" name="ref_type" value="{{.CreatePlan.RefType}}">
				<input type="hidden" name="ref_name" value="{{.CreatePlan.RefName}}">
				<input type="hidden" name="request_hash" value="{{.CreatePlan.RequestHash}}">

				<div class="ui attached segment">{{template "codespace/create_source" .}}</div>

				{{if .CreateError}}
					<div class="ui attached segment">
						<div class="ui negative message" role="alert">{{.CreateError}}</div>
					</div>
				{{end}}

				<div class="ui attached segment codespace-create-section">
						<h4 class="ui header">{{ctx.Locale.Tr "codespace.development_environment"}}</h4>
						<div class="codespace-create-environment-fields">
							<div class="required field">
								<label for="codespace-environment-tag">{{ctx.Locale.Tr "codespace.runtime_environment"}}</label>
								{{$selectedEnvironment := .CreateSelectedEnvironment}}
								<div id="codespace-environment-tag" class="ui fluid selection dropdown codespace-scope-dropdown" tabindex="0">
									<input type="hidden" name="environment_tag" value="{{if $selectedEnvironment}}{{$selectedEnvironment.Tag}}{{end}}">
									{{svg "octicon-triangle-down" 14 "dropdown icon"}}
									<div class="{{if not $selectedEnvironment}}default {{end}}text">
										{{if $selectedEnvironment}}
											<span class="tw-min-w-0 tw-flex-1 tw-truncate">{{$selectedEnvironment.Tag}}</span>
											<span class="tw-flex tw-shrink-0 tw-gap-1">
												{{range $scopeLabel := $selectedEnvironment.ScopeLabels}}<span class="ui tiny basic label codespace-scope-label">{{$scopeLabel}}</span>{{end}}
												{{if not $selectedEnvironment.Online}}<span class="ui tiny red label codespace-scope-label">{{ctx.Locale.Tr "codespace.manager_status.offline"}}</span>{{end}}
											</span>
										{{else}}
											{{ctx.Locale.Tr "codespace.environment_select"}}
										{{end}}
									</div>
									<div class="menu flex-items-menu">
										{{range $environment := .CreateEnvironmentOptions}}
											<div class="item" data-value="{{$environment.Tag}}">
												<span class="tw-min-w-0 tw-flex-1 tw-truncate">{{$environment.Tag}}</span>
												<span class="tw-flex tw-shrink-0 tw-gap-1">
													{{range $scopeLabel := $environment.ScopeLabels}}<span class="ui tiny basic label codespace-scope-label">{{$scopeLabel}}</span>{{end}}
													{{if not $environment.Online}}<span class="ui tiny red label codespace-scope-label">{{ctx.Locale.Tr "codespace.manager_status.offline"}}</span>{{end}}
												</span>
											</div>
										{{end}}
									</div>
								</div>
								{{range $environment := .CreatePlan.Environments}}
									{{if not $environment.Online}}
										<div class="help{{if not $environment.Selected}} tw-hidden{{end}}" data-codespace-environment-detail="{{$environment.Tag}}">{{ctx.Locale.Tr "codespace.environment_offline_queue"}}</div>
									{{end}}
								{{end}}
							</div>
							<div class="field">
								<label for="codespace-dev-container">{{ctx.Locale.Tr "codespace.dev_container_configuration"}}</label>
								{{$selectedConfiguration := .CreateSelectedConfiguration}}
								<div id="codespace-dev-container" class="ui fluid selection dropdown codespace-scope-dropdown codespace-dev-container-dropdown" tabindex="0">
									<input type="hidden" name="dev_container" value="{{if $selectedConfiguration}}{{$selectedConfiguration.Selection}}{{end}}"
										data-codespace-dev-container data-preview-url="{{.RepoLink}}/codespaces/new" data-ref-type="{{.CreatePlan.RefType}}" data-ref-name="{{.CreatePlan.RefName}}">
									{{svg "octicon-triangle-down" 14 "dropdown icon"}}
									<div class="{{if not $selectedConfiguration}}default {{end}}text">
										{{if $selectedConfiguration}}
											<span class="tw-min-w-0 tw-flex-1 tw-truncate">{{$selectedConfiguration.Name}}</span>
											<span class="ui tiny basic label codespace-scope-label">{{$selectedConfiguration.ScopeLabel}}</span>
										{{else}}
											{{ctx.Locale.Tr "codespace.configuration_select"}}
										{{end}}
									</div>
									<div class="menu flex-items-menu">
										{{range $option := .CreateConfigurationOptions}}
											<div class="item" data-value="{{$option.Selection}}">
												<span class="tw-min-w-0 tw-flex-1 tw-truncate">{{$option.Name}}</span>
												<span class="ui tiny basic label codespace-scope-label">{{$option.ScopeLabel}}</span>
											</div>
										{{end}}
									</div>
								</div>
								<div class="ui warning message tw-hidden" data-codespace-review-warning>{{ctx.Locale.Tr "codespace.configuration_review_warning"}}</div>
								<button class="ui button tw-hidden" type="button" data-codespace-review>{{ctx.Locale.Tr "codespace.configuration_review"}}</button>
							</div>
						</div>
					</div>

				{{if .CreatePlan.RequestHash}}
				<div class="ui attached segment codespace-create-section">
					<h4 class="ui header">{{ctx.Locale.Tr "codespace.repository_access"}}</h4>
					{{if .CreatePermissionRepositories}}
						<p class="help">{{ctx.Locale.Tr "codespace.additional_permissions_explanation"}}</p>
						{{range $repository := .CreatePermissionRepositories}}
							<div class="codespace-create-permission-repository">
								<div class="codespace-create-permission-repository-name">{{svg "octicon-repo"}} <strong>{{$repository.FullName}}</strong></div>
								<div class="codespace-create-permission-list">
									{{range $permission := $repository.Permissions}}
										{{$selected := index $.CreatePermissionGrants $permission.FormName}}
										<div class="codespace-create-permission-row">
											<span>{{$permission.UnitName}}</span>
											{{if $permission.Required}}
												<span class="tw-text-text-light-2">{{ctx.Locale.Tr "codespace.pull_request_source_permission"}}</span>
											{{else}}
												<div class="codespace-create-permission-options">
													<label class="gt-checkbox"><input type="radio" name="{{$permission.FormName}}" value="none"{{if eq $selected "none"}} checked{{end}}> {{ctx.Locale.Tr "settings.permission_no_access"}}</label>
													<label class="gt-checkbox"><input type="radio" name="{{$permission.FormName}}" value="read"{{if eq $selected "read"}} checked{{end}}> {{ctx.Locale.Tr "settings.permission_read"}}</label>
											{{if eq $permission.ModeName "write"}}
												<label class="gt-checkbox"><input type="radio" name="{{$permission.FormName}}" value="write"{{if eq $selected "write"}} checked{{end}}> {{ctx.Locale.Tr "settings.permission_write"}}</label>
											{{end}}
												</div>
											{{end}}
										</div>
									{{end}}
								</div>
							</div>
						{{end}}
					{{else}}
						<p class="help">{{ctx.Locale.Tr "codespace.source_repository_permission_explanation"}}</p>
					{{end}}
				</div>

				<div class="ui attached segment codespace-create-section">
					<h4 class="ui header">{{ctx.Locale.Tr "codespace.secrets"}}</h4>
					{{if not .CreatePlan.SecretInjectionAllowed}}
						<div class="ui warning message">
							{{if and .CreatePlan.PullRequest .CreatePlan.PullRequest.IsFork}}{{ctx.Locale.Tr "codespace.secrets_fork_pull_unavailable"}}{{else}}{{ctx.Locale.Tr "codespace.secrets_write_access_required"}}{{end}}
						</div>
					{{else}}
						{{if .CreatePlan.AvailableSecrets}}
								<p class="help">{{ctx.Locale.Tr "codespace.secrets_available_description"}}</p>
								<div class="flex-divided-list items-with-main codespace-create-secret-list">
									{{range $secret := .CreatePlan.AvailableSecrets}}
										<div class="item codespace-create-secret-item">
											<div class="item-leading">{{svg "octicon-key" 24}}</div>
											<div class="item-main">
												<div class="item-title"><strong>{{$secret.Name}}</strong></div>
												{{if $secret.Description}}<div class="item-body">{{$secret.Description}}</div>{{end}}
										</div>
									</div>
								{{end}}
							</div>
						{{else}}
							<div class="codespace-create-secret-empty">{{ctx.Locale.Tr "codespace.secrets_none_for_create"}}</div>
						{{end}}
						{{if .CreateHasPendingRecommendedSecret}}
							<h5 class="ui header codespace-create-recommended-secret-heading">{{ctx.Locale.Tr "codespace.recommended_secrets"}}</h5>
							<p class="help">{{ctx.Locale.Tr "codespace.recommended_secrets_description"}}</p>
							<div class="flex-divided-list items-with-main codespace-create-secret-list">
								{{range $secret := .CreatePlan.RecommendedSecrets}}
									{{if not $secret.Available}}
										<div class="item codespace-create-secret-item">
											<div class="item-leading">{{svg "octicon-key" 24}}</div>
											<div class="item-main">
												<div class="item-title"><strong>{{$secret.Name}}</strong></div>
												{{if $secret.Description}}<div class="item-body">{{$secret.Description}}</div>{{end}}
											</div>
											<div class="item-trailing codespace-create-secret-control">
												{{if $secret.Configured}}
											<label class="gt-checkbox">
												<input type="checkbox" name="recommended_secret_enable_{{$secret.Name}}" value="true"{{if index $.CreateRecommendedSecretEnabled $secret.Name}} checked{{end}}>
												{{ctx.Locale.Tr "codespace.secret_allow_repository"}}
											</label>
												{{else}}
													<input type="password" name="recommended_secret_value_{{$secret.Name}}" autocomplete="new-password" placeholder="{{ctx.Locale.Tr "codespace.secret_optional_value"}}" aria-label="{{$secret.Name}}">
												{{end}}
											</div>
										</div>
									{{end}}
								{{end}}
							</div>
						{{end}}
					{{end}}
					<div class="codespace-create-secret-footer">
						<a href="{{AppSubUrl}}/user/settings/codespaces/secrets" target="_blank" rel="noopener noreferrer">{{ctx.Locale.Tr "codespace.secrets_manage"}} {{svg "octicon-link-external" 14}}</a>
					</div>
				</div>

				{{end}}
				<div class="ui bottom attached segment tw-flex tw-justify-end tw-gap-2">
					<a class="ui button" href="{{.RepoLink}}">{{ctx.Locale.Tr "cancel"}}</a>
					<button class="ui primary button" type="submit" data-codespace-create{{if not .CreatePlan.RequestHash}} disabled{{end}}>{{svg "octicon-plus"}} {{ctx.Locale.Tr "codespace.confirm_and_create"}}</button>
				</div>
			</form>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
