{{if .}}
	<span class="badge-list tw-inline-flex tw-items-center tw-gap-1 tw-align-middle">
		{{range .}}
			<span class="ui basic label tw-px-2 tw-py-1 tw-text-xs tw-font-normal" {{if .Description}}data-tooltip-content="{{.Description}}"{{end}} {{if .Color}}style="border-color: {{.Color}}; color: {{.Color}}"{{end}}>
				{{.Slug}}
			</span>
		{{end}}
	</span>
{{end}}
