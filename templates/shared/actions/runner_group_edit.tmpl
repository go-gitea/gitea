<div class="runner-container">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "actions.runners.groups.edit"}} {{.RunnerGroup.Name}}
	</h4>
	<div class="ui attached segment">
		<form class="ui form" method="post">
			<div class="field">
				<label>{{ctx.Locale.Tr "actions.runners"}}</label>
				<div class="ui fluid multiple selection dropdown custom" data-global-init="initRunnerGroupMembersInput" data-runner-link="{{.RunnerLink}}" aria-label="{{ctx.Locale.Tr "actions.runners"}}">
					<input type="hidden" name="runners" value="{{StringUtils.Join .RunnerGroupMemberIDs ","}}">
					<div class="default text">{{ctx.Locale.Tr "actions.runners.groups.no_runners"}}</div>
					<div class="menu">
						{{range .RunnerGroupCandidates}}<div class="item" data-value="{{.ID}}">{{.Name}}</div>{{end}}
					</div>
				</div>
				<p class="help">{{ctx.Locale.Tr "actions.runners.groups.runners_help"}}</p>
			</div>

			<div class="field">
				<label>{{ctx.Locale.Tr "actions.runners.groups.repos"}}</label>
				<div class="ui fluid multiple search selection dropdown custom" data-global-init="initRunnerAccessInput" aria-label="{{ctx.Locale.Tr "actions.runners.groups.repos"}}" data-uid="{{.RunnerGroup.OwnerID}}">
					<input type="hidden" name="repos" value="{{range $i, $repo := .RunnerGroupRepos}}{{if $i}},{{end}}{{$repo.ID}}{{end}}">
					<div class="default text">{{ctx.Locale.Tr "search.repo_kind"}}</div>
					<div class="menu">
						{{range .RunnerGroupRepos}}<div class="item" data-value="{{.ID}}">{{.FullName}}</div>{{end}}
					</div>
				</div>
				<p class="help">{{ctx.Locale.Tr "actions.runners.groups.repos_help"}}</p>
			</div>

			<div class="divider"></div>

			<div class="field">
				<button type="submit" class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
				<button type="button" class="ui red button link-action" data-url="{{.Link}}/delete"
					data-modal-confirm-header="{{ctx.Locale.Tr "actions.runners.groups.delete_header"}}"
					data-modal-confirm-content="{{ctx.Locale.Tr "actions.runners.groups.delete_notice"}}"
				>
					{{ctx.Locale.Tr "actions.runners.groups.delete"}}
				</button>
			</div>
		</form>
	</div>
</div>
