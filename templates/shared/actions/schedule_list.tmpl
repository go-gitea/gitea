<div class="actions-settings-container">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "actions.schedules.manage_panel"}} ({{ctx.Locale.Tr "admin.total" .Total}})
	</h4>
	{{if .Schedules}}
	<div class="ui attached table segment">
		<table class="ui very basic table unstackable">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "actions.schedules.id"}}</th>
					{{if not .IsRepoSchedules}}<th>{{ctx.Locale.Tr "repository"}}</th>{{end}}
					<th>{{ctx.Locale.Tr "actions.schedules.workflow"}}</th>
					<th>{{ctx.Locale.Tr "actions.schedules.spec"}}</th>
					<th>{{ctx.Locale.Tr "actions.schedules.ref"}}</th>
					<th>{{ctx.Locale.Tr "actions.schedules.next_run"}}</th>
					<th>{{ctx.Locale.Tr "actions.schedules.last_run"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range $schedule := .Schedules}}
				{{range $i, $spec := .Specs}}
				<tr>
					{{if eq $i 0}}
					{{/* the cells below describe the schedule, not the cron expression, so they span its spec rows */}}
					<td rowspan="{{len $schedule.Specs}}">{{$schedule.Schedule.ID}}</td>
					{{if not $.IsRepoSchedules}}
					<td rowspan="{{len $schedule.Specs}}">
						{{if $schedule.Repo}}
							<a href="{{$schedule.Repo.Link}}">{{$schedule.Repo.FullName}}</a>
						{{else}}
							{{$schedule.Schedule.RepoID}}
						{{end}}
					</td>
					{{end}}
					<td rowspan="{{len $schedule.Specs}}">{{$schedule.Schedule.WorkflowID}}</td>
					{{end}}
					<td><span class="ui label">{{$spec.Spec}}</span></td>
					{{if eq $i 0}}
					<td rowspan="{{len $schedule.Specs}}"><span class="ui label">{{$schedule.Schedule.PrettyRef}}</span></td>
					{{end}}
					{{if not $spec.Row}}
					<td colspan="2">{{svg "octicon-alert"}} {{ctx.Locale.Tr "actions.schedules.invalid_spec"}}</td>
					{{else}}
					<td>
						{{if $schedule.SkipReason}}
							{{svg "octicon-alert"}} {{ctx.Locale.Tr $schedule.SkipReason}}
						{{else if le $spec.Row.Next 0}}
							{{svg "octicon-alert"}} {{ctx.Locale.Tr "actions.schedules.unsatisfiable_spec"}}
						{{else}}
							{{DateUtils.FullTime $spec.Row.Next}}
						{{end}}
					</td>
					<td>{{if $spec.Row.Prev}}{{DateUtils.FullTime $spec.Row.Prev}}{{else}}{{ctx.Locale.Tr "never"}}{{end}}</td>
					{{end}}
				</tr>
				{{end}}
				{{end}}
			</tbody>
		</table>
	</div>
	{{else}}
	<div class="ui attached segment tw-text-center">{{ctx.Locale.Tr "actions.schedules.none"}}</div>
	{{end}}

	{{template "base/paginate" .}}
</div>
