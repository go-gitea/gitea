<div id="actions-job-queue" class="runner-container" data-global-init="initActionJobQueueList"
	data-job-queue-refresh-link="{{.JobQueueRefreshLink}}"
	data-job-queue-refresh-interval="{{.JobQueueRefreshIntervalMs}}"
>
	<div class="ui top attached header flex-left-right">
		<strong>{{ctx.Locale.Tr "actions.job_queue.title"}} ({{ctx.Locale.Tr "admin.total" .JobQueueTotal}})</strong>
		<div class="ui secondary filter menu flex-text-block tw-m-0" id="actions-job-queue-filter">
			{{if .ShowRepoColumn}}
			<div class="dropdown-container">
				<button type="button" class="dropdown-trigger item"{{if not .JobQueueFilterOwners}} disabled{{end}}>{{if .JobQueueFilterOwnerName}}{{.JobQueueFilterOwnerName}}{{else}}{{ctx.Locale.Tr "repo.owner"}}{{end}} {{svg "octicon-triangle-down" 14}}</button>
				<div class="dropdown-popup">
					<input class="dropdown-filter" type="search" placeholder="{{ctx.Locale.Tr "repo.owner"}}">
					<a class="dropdown-item{{if not .JobQueueFilterOwnerID}} active{{end}}" href="?status={{.JobQueueFilterStatus}}">{{ctx.Locale.Tr "actions.job_queue.filter_owner_no_select"}}</a>
					{{range .JobQueueFilterOwners}}
						<a class="dropdown-item{{if eq .ID $.JobQueueFilterOwnerID}} active{{end}}" href="?owner_id={{.ID}}&status={{$.JobQueueFilterStatus}}">{{.Name}}</a>
					{{end}}
				</div>
			</div>
			<div class="dropdown-container">
				<button type="button" class="dropdown-trigger item"{{if not .JobQueueFilterRepos}} disabled{{end}}>{{if .JobQueueFilterRepoName}}{{.JobQueueFilterRepoName}}{{else}}{{ctx.Locale.Tr "repository"}}{{end}} {{svg "octicon-triangle-down" 14}}</button>
				<div class="dropdown-popup">
					<input class="dropdown-filter" type="search" placeholder="{{ctx.Locale.Tr "repository"}}">
					<a class="dropdown-item{{if not .JobQueueFilterRepoID}} active{{end}}" href="?owner_id={{.JobQueueFilterOwnerID}}&status={{.JobQueueFilterStatus}}">{{ctx.Locale.Tr "actions.job_queue.filter_repo_no_select"}}</a>
					{{range .JobQueueFilterRepos}}
						<a class="dropdown-item{{if eq .ID $.JobQueueFilterRepoID}} active{{end}}" href="?repo_id={{.ID}}&status={{$.JobQueueFilterStatus}}">{{.FullName}}</a>
					{{end}}
				</div>
			</div>
			{{end}}
			<div class="dropdown-container">
				<button type="button" class="dropdown-trigger item">{{if .JobQueueFilterStatus}}{{ctx.Locale.Tr (printf "actions.status.%s" .JobQueueFilterStatus)}}{{else}}{{ctx.Locale.Tr "actions.runs.status"}}{{end}} {{svg "octicon-triangle-down" 14}}</button>
				<div class="dropdown-popup">
					<a class="dropdown-item{{if not .JobQueueFilterStatus}} active{{end}}" href="?owner_id={{.JobQueueFilterOwnerID}}&repo_id={{.JobQueueFilterRepoID}}">{{ctx.Locale.Tr "actions.runs.status_no_select"}}</a>
					{{range $status := .JobQueueFilterStatuses}}
						<a class="dropdown-item{{if eq $status $.JobQueueFilterStatus}} active{{end}}" href="?owner_id={{$.JobQueueFilterOwnerID}}&repo_id={{$.JobQueueFilterRepoID}}&status={{$status}}">
							<span class="flex-text-inline tw-gap-2">
								{{template "repo/icons/action_status" (dict "Status" $status)}}
								{{ctx.Locale.Tr (printf "actions.status.%s" $status)}}
							</span>
						</a>
					{{end}}
				</div>
			</div>
		</div>
	</div>
	<div class="ui attached table segment">
	{{if .JobQueueJobs}}
		<table class="ui very basic table unstackable">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "actions.runs.status"}}</th>
					{{if .ShowRepoColumn}}<th>{{ctx.Locale.Tr "repository"}}</th>{{end}}
					<th>{{ctx.Locale.Tr "actions.runners.task_list.job"}}</th>
					<th>{{ctx.Locale.Tr "actions.job_queue.runs_on"}}</th>
					<th>{{ctx.Locale.Tr "actions.runners.runner_title"}}</th>
					<th>{{ctx.Locale.Tr "actions.runs.commit"}}</th>
					<th>{{ctx.Locale.Tr "actions.job_queue.waiting_or_started"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range $job := .JobQueueJobs}}
				<tr>
					<td>
						<span class="flex-text-inline" data-tooltip-content="{{$job.Status.LocaleString ctx.Locale}}">
							{{template "repo/icons/action_status" (dict "Status" $job.Status.String)}}
						</span>
					</td>
					{{if $.ShowRepoColumn}}<td>{{if $job.Repo}}<a href="{{$job.Repo.Link}}">{{$job.Repo.FullName}}</a>{{end}}</td>{{end}}
					<td>{{if $job.Run}}<a href="{{$job.Run.Link}}">{{$job.Name}} <span class="text grey">#{{$job.Run.Index}}</span></a>{{else}}{{$job.Name}}{{end}}</td>
					<td><span class="flex-text-inline tw-flex-wrap">{{range $job.RunsOn}}<span class="ui label">{{.}}</span>{{end}}</span></td>
					<td>{{index $.JobQueueRunners $job.TaskID}}</td>
					<td>{{if and $job.Run $job.Repo}}<a href="{{$job.Repo.Link}}/commit/{{$job.Run.CommitSHA}}">{{ShortSha $job.Run.CommitSHA}}</a>{{end}}</td>
					<td>{{if $job.Started}}{{DateUtils.TimeSince $job.Started}}{{else}}{{DateUtils.TimeSince $job.Updated}}{{end}}</td>
				</tr>
				{{end}}
			</tbody>
		</table>
	{{else}}
		<div class="tw-text-center tw-p-4">{{ctx.Locale.Tr "actions.job_queue.no_jobs"}}</div>
	{{end}}
	{{template "base/paginate" .}}
	</div>

</div>
