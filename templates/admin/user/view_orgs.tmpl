<div class="flex-divided-list items-with-main">
	{{range $user := .Users}}
		<div class="item tw-items-center">
			<div class="item-leading">
				{{ctx.AvatarUtils.Avatar $user 48}}
			</div>
			<div class="item-main">
				<div class="item-title">
					{{template "shared/user/name" $user}}
					{{if $user.Visibility.IsPrivate}}
						<span class="ui basic tiny label">{{ctx.Locale.Tr "repo.desc.private"}}</span>
					{{end}}
				</div>
				<div class="item-body">
					{{if $user.Location}}
						<span class="flex-text-inline">{{svg "octicon-location"}}{{$user.Location}}</span>
					{{end}}
					<span class="flex-text-inline">{{svg "octicon-calendar"}}{{ctx.Locale.Tr "user.joined_on" (DateUtils.AbsoluteShort $user.CreatedUnix)}}</span>
				</div>
			</div>
			<div class="item-trailing">
				<form method="post" action="{{$.Link}}/orgs/{{$user.ID}}/remove">
					<button class="ui red tiny button" type="submit">{{ctx.Locale.Tr "remove"}}</button>
				</form>
			</div>
		</div>
	{{else}}
		<div class="item">
			{{ctx.Locale.Tr "search.no_results"}}
		</div>
	{{end}}
</div>
