<h4 class="ui top attached header">{{ctx.Locale.Tr "admin.config.diff_highlight_cache"}}</h4>
<div class="ui attached segment">
	<form class="ui form system-config-form" method="post" action="{{AppSubUrl}}/-/admin/config">
		{{$cfg := .SystemConfig.Repository.DiffHighlightCache}}
		{{$key := $cfg.DynKey}}
		{{$cache := $cfg.Value ctx}}
		<input type="hidden" data-config-dyn-key="{{$key}}" data-config-value-json="{{JsonUtils.EncodeToString $cache}}">
		<div class="field">
			<div class="ui checkbox">
				<input type="checkbox" name="{{$key}}.Enabled" data-config-value-type="boolean" {{if $cache.Enabled}}checked{{end}}>
				<label>{{ctx.Locale.Tr "admin.config.diff_highlight_cache.enabled"}}</label>
			</div>
		</div>
		<div class="field">
			<label>{{ctx.Locale.Tr "admin.config.diff_highlight_cache.size"}}</label>
			<input type="number" name="{{$key}}.SizeMiB" value="{{$cache.SizeMiB}}" data-config-value-type="number" min="1" step="1" required>
		</div>
		<div class="field">
			<button type="submit" class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
		</div>
	</form>
</div>
