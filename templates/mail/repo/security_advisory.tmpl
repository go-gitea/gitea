<!DOCTYPE html>
<html>
<head>
	{{template "mail/base/head" .Subject}}
</head>

{{$advisory_url := HTMLFormat "<a href='%s'>%s</a>" .Link .Title}}
{{$repo_url := HTMLFormat "<a href='%s'>%s</a>" .RepoLink .RepoName}}
<body>
	<p>{{.locale.Tr .TextKey .DoerName $advisory_url $repo_url}}</p>
	<p><a href="{{.Link}}">{{.locale.Tr "mail.view_it_on" AppName}}</a></p>
	{{template "mail/base/footer"}}
</body>
</html>
