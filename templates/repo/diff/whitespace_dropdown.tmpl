<div class="dropdown-container">
	<button type="button" class="dropdown-trigger ui tiny basic button" aria-label="{{ctx.Locale.Tr "repo.diff.whitespace_button"}}" data-tooltip-content="{{ctx.Locale.Tr "repo.diff.whitespace_button"}}">
		{{svg "gitea-whitespace"}}
	</button>
	<div class="dropdown-popup dropdown-popup-button tw-text-12">
		<a class="dropdown-item {{if eq .WhitespaceBehavior "show-all"}}active{{end}}" role="menuitemradio" aria-checked="{{eq .WhitespaceBehavior "show-all"}}" href="?style={{if .IsSplitStyle}}split{{else}}unified{{end}}&whitespace=show-all&show-outdated={{$.ShowOutdatedComments}}">
			<label class="tw-pointer-events-none">
				<input type="radio" class="tw-mr-2" tabindex="-1" aria-hidden="true" {{if eq .WhitespaceBehavior "show-all"}}checked{{end}}>
				{{ctx.Locale.Tr "repo.diff.whitespace_show_everything"}}
			</label>
		</a>
		<a class="dropdown-item {{if eq .WhitespaceBehavior "ignore-all"}}active{{end}}" role="menuitemradio" aria-checked="{{eq .WhitespaceBehavior "ignore-all"}}" href="?style={{if .IsSplitStyle}}split{{else}}unified{{end}}&whitespace=ignore-all&show-outdated={{$.ShowOutdatedComments}}">
			<label class="tw-pointer-events-none">
				<input type="radio" class="tw-mr-2" tabindex="-1" aria-hidden="true" {{if eq .WhitespaceBehavior "ignore-all"}}checked{{end}}>
				{{ctx.Locale.Tr "repo.diff.whitespace_ignore_all_whitespace"}}
			</label>
		</a>
		<a class="dropdown-item {{if eq .WhitespaceBehavior "ignore-change"}}active{{end}}" role="menuitemradio" aria-checked="{{eq .WhitespaceBehavior "ignore-change"}}" href="?style={{if .IsSplitStyle}}split{{else}}unified{{end}}&whitespace=ignore-change&show-outdated={{$.ShowOutdatedComments}}">
			<label class="tw-pointer-events-none">
				<input type="radio" class="tw-mr-2" tabindex="-1" aria-hidden="true" {{if eq .WhitespaceBehavior "ignore-change"}}checked{{end}}>
				{{ctx.Locale.Tr "repo.diff.whitespace_ignore_amount_changes"}}
			</label>
		</a>
		<a class="dropdown-item {{if eq .WhitespaceBehavior "ignore-eol"}}active{{end}}" role="menuitemradio" aria-checked="{{eq .WhitespaceBehavior "ignore-eol"}}" href="?style={{if .IsSplitStyle}}split{{else}}unified{{end}}&whitespace=ignore-eol&show-outdated={{$.ShowOutdatedComments}}">
			<label class="tw-pointer-events-none">
				<input type="radio" class="tw-mr-2" tabindex="-1" aria-hidden="true" {{if eq .WhitespaceBehavior "ignore-eol"}}checked{{end}}>
				{{ctx.Locale.Tr "repo.diff.whitespace_ignore_at_eol"}}
			</label>
		</a>
	</div>
</div>
<a class="ui tiny basic button" href="?style={{if .IsSplitStyle}}unified{{else}}split{{end}}&whitespace={{$.WhitespaceBehavior}}&show-outdated={{$.ShowOutdatedComments}}" data-tooltip-content="{{if .IsSplitStyle}}{{ctx.Locale.Tr "repo.diff.show_unified_view"}}{{else}}{{ctx.Locale.Tr "repo.diff.show_split_view"}}{{end}}">{{svg (Iif .IsSplitStyle "gitea-join" "gitea-split")}}</a>
