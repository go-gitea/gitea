{{/* the code of a diff snippet, like in the PR conversation and the editor's preview */}}
{{$file := $.file}}
<colgroup>
	<col width="50">
	<col width="50">
	<col width="10">
	<col width="10">
	<col>
</colgroup>
{{range $section := $file.Sections}}
	{{range $line := $section.Lines}}
		<tr class="{{$line.GetHTMLDiffLineType}}-code" data-line-type="{{$line.GetHTMLDiffLineType}}">
			{{if $line.IsDiffLineSection}}
				<td colspan="2" class="lines-num"></td>
			{{else}}
				<td class="lines-num lines-num-old" data-line-num="{{if $line.LeftIdx}}{{$line.LeftIdx}}{{end}}"><span rel="{{if $line.LeftIdx}}diff-{{$file.NameHash}}L{{$line.LeftIdx}}{{end}}"></span></td>
				<td class="lines-num lines-num-new" data-line-num="{{if $line.RightIdx}}{{$line.RightIdx}}{{end}}"><span rel="{{if $line.RightIdx}}diff-{{$file.NameHash}}R{{$line.RightIdx}}{{end}}"></span></td>
			{{end}}
			{{$inlineDiff := $section.GetComputedInlineDiffFor $line ctx.Locale -}}
			<td class="lines-escape">
				{{ctx.RenderUtils.RenderUnicodeEscapeToggleButton $inlineDiff.EscapeStatus}}
			</td>
			<td class="lines-type-marker"><span class="tw-font-mono" data-type-marker="{{$line.GetLineTypeMarker}}"></span></td>
			{{if $line.IsDiffLineSection}}
				<td class="chroma lines-code blob-hunk">{{template "repo/diff/section_code" dict "diff" $inlineDiff}}</td>
			{{else}}
				<td class="chroma lines-code{{if (not $line.RightIdx)}} lines-code-old{{end}}">{{template "repo/diff/section_code" dict "diff" $inlineDiff}}</td>
			{{end}}
		</tr>
	{{end}}
{{end}}
