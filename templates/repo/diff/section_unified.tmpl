{{$file := $.file}}
{{/* this tmpl is also used by the PR Conversation page, so "DiffBlobExcerptData" may not exist */}}
{{$diffBlobExcerptData := ctx.RootData.DiffBlobExcerptData}}
{{$canAddComment := and $.selectable ctx.RootData.SignedUserID $diffBlobExcerptData.PullIssueIndex}}
<colgroup>
	<col width="50">
	<col width="50">
	<col width="10">
	<col width="10">
	<col>
</colgroup>
{{range $section := $file.Sections}}
	{{range $line := $section.Lines}}
		<tr class="{{$line.GetHTMLDiffLineType}}-code" data-line-type="{{$line.GetHTMLDiffLineType}}">
			{{if $line.IsDiffLineSection}}
				{{if $diffBlobExcerptData}}
					<td colspan="2" class="lines-num">{{$line.RenderBlobExcerptButtons $file.NameHash $diffBlobExcerptData}}</td>
				{{else}}
					{{/* when DiffBlobExcerptData is not available (code file preview, pull conversation diff comment), do not show the expansion arrows */}}
					<td colspan="2" class="lines-num"></td>
				{{end}}
			{{else}}
				<td data-diff-column="unified" class="lines-num lines-num-old">{{template "repo/diff/line_number" dict "Number" $line.LeftIdx "FileNameHash" (and $.selectable $file.NameHash) "Side" "L"}}</td>
				<td data-diff-column="unified" class="lines-num lines-num-new">{{template "repo/diff/line_number" dict "Number" $line.RightIdx "FileNameHash" (and $.selectable $file.NameHash) "Side" "R"}}</td>
			{{end}}
			{{$inlineDiff := $section.GetComputedInlineDiffFor $line ctx.Locale -}}
			<td {{if not $line.IsDiffLineSection}}data-diff-column="unified" {{end}}class="lines-escape">
				{{ctx.RenderUtils.RenderUnicodeEscapeToggleButton $inlineDiff.EscapeStatus}}
			</td>
			<td {{if not $line.IsDiffLineSection}}data-diff-column="unified" {{end}}class="lines-type-marker"><span class="tw-font-mono" data-type-marker="{{$line.GetLineTypeMarker}}"></span></td>
			{{if $line.IsDiffLineSection}}
				<td class="chroma lines-code blob-hunk">{{template "repo/diff/section_code" dict "diff" $inlineDiff}}</td>
			{{else}}
				<td data-diff-column="unified" class="chroma lines-code{{if (not $line.RightIdx)}} lines-code-old{{end}}">
					{{- if $canAddComment -}}
						<button type="button" aria-label="{{ctx.Locale.Tr "repo.diff.comment.add_line_comment"}}" class="ui primary button add-code-comment add-code-comment-{{if $line.RightIdx}}right{{else}}left{{end}}{{if (not $line.CanComment)}} tw-invisible{{end}}" data-side="{{if $line.RightIdx}}right{{else}}left{{end}}" data-global-click="onAddDiffComment">
							{{- svg "octicon-plus" -}}
						</button>
					{{- end -}}
					{{- template "repo/diff/section_code" dict "diff" $inlineDiff -}}
				</td>
			{{end}}
		</tr>
		{{if $line.Comments}}
			<tr class="add-comment" data-line-type="{{$line.GetHTMLDiffLineType}}">
				<td class="add-comment-left add-comment-right" colspan="5">
					{{template "repo/diff/conversation" dict "comments" $line.Comments}}
				</td>
			</tr>
		{{end}}
	{{end}}
{{end}}
