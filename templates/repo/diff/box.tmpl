{{$showFileTree := (and (not .DiffNotAvailable) (gt .DiffShortStat.NumFiles 1))}}
<div>
	<div class="diff-detail-box">
		<div class="flex-text-block tw-flex-wrap tw-ml-0.5">
			{{if $showFileTree}}
				<button type="button" class="diff-toggle-file-tree-button not-mobile btn interact-fg" data-show-text="{{ctx.Locale.Tr "repo.diff.show_file_tree"}}" data-hide-text="{{ctx.Locale.Tr "repo.diff.hide_file_tree"}}">
					{{/* the icon meaning is reversed here, "octicon-sidebar-collapse" means show the file tree */}}
					{{svg "octicon-sidebar-collapse" 20 "icon tw-hidden"}}
					{{svg "octicon-sidebar-expand" 20 "icon tw-hidden"}}
				</button>
				<script nonce="{{ctx.CspScriptNonce}}">
					// Default to true if unset
					const diffTreeVisible = window.localUserSettings.getBoolean('diff_file_tree_visible', true);
					const diffTreeBtn = document.querySelector('.diff-toggle-file-tree-button');
					const diffTreeIcon = `.octicon-sidebar-${diffTreeVisible ? 'expand' : 'collapse'}`;
					diffTreeBtn.querySelector(diffTreeIcon).classList.remove('tw-hidden');
					diffTreeBtn.setAttribute('data-tooltip-content', diffTreeBtn.getAttribute(diffTreeVisible ? 'data-hide-text' : 'data-show-text'));
				</script>
			{{end}}
			{{if .ShowDiffSummaryInToolbar}}
				<div class="diff-detail-stats tw-flex tw-items-center tw-flex-wrap">
					{{svg "octicon-diff" 16 "tw-mr-1"}}{{ctx.Locale.Tr "repo.diff.stats_desc" .DiffShortStat.NumFiles .DiffShortStat.TotalAddition .DiffShortStat.TotalDeletion}}
				</div>
			{{end}}
		</div>
		<div class="diff-detail-actions">
			{{if and .PageIsPullFiles $.SignedUserID (not .DiffNotAvailable)}}
				<div class="not-mobile tw-flex tw-items-center tw-flex-col tw-whitespace-nowrap tw-mr-1">
					<label for="viewed-files-summary" id="viewed-files-summary-label" data-text-changed-template="{{ctx.Locale.Tr "repo.pulls.viewed_files_label"}}">
						{{ctx.Locale.Tr "repo.pulls.viewed_files_label" .NumViewedFiles .DiffShortStat.NumFiles}}
					</label>
					<progress id="viewed-files-summary" value="{{.NumViewedFiles}}" max="{{.DiffShortStat.NumFiles}}"></progress>
				</div>
			{{end}}
			{{template "repo/diff/whitespace_dropdown" .}}
			{{template "repo/diff/options_dropdown" .}}
			{{if .PageIsPullFiles}}
				<div id="diff-commit-select" data-merge-base="{{$.CompareInfo.CompareBase}}" data-issuelink="{{$.Issue.Link}}"
					data-queryparams="?style={{if $.IsSplitStyle}}split{{else}}unified{{end}}&whitespace={{$.WhitespaceBehavior}}&show-outdated={{$.ShowOutdatedComments}}"
					data-text-filter-changes-by-commit="{{ctx.Locale.Tr "repo.pulls.filter_changes_by_commit"}}">
					{{/* the following will be replaced by vue component, but this avoids any loading artifacts till the vue component is initialized */}}
					<div class="ui jump dropdown tiny basic button custom">
						{{svg "octicon-git-commit"}}
					</div>
				</div>
			{{end}}
			{{if and .PageIsPullFiles $.SignedUserID}}
				{{template "repo/diff/new_review" .}}
			{{end}}
		</div>
	</div>
	{{if not .DiffNotAvailable}}
		{{if and .IsShowingOnlySingleCommit .PageIsPullFiles}}
			<div class="ui info message">
				<div>{{ctx.Locale.Tr "repo.pulls.showing_only_single_commit" (ShortSha .AfterCommitID)}} - <a href="{{$.Issue.Link}}/files?style={{if $.IsSplitStyle}}split{{else}}unified{{end}}&whitespace={{$.WhitespaceBehavior}}&show-outdated={{$.ShowOutdatedComments}}">{{ctx.Locale.Tr "repo.pulls.show_all_commits"}}</a></div>
			</div>
		{{else if and (not .IsShowingAllCommits) .PageIsPullFiles}}
			<div class="ui info message">
				<div>{{ctx.Locale.Tr "repo.pulls.showing_specified_commit_range" (ShortSha .BeforeCommitID) (ShortSha .AfterCommitID)}} - <a href="{{$.Issue.Link}}/files?style={{if $.IsSplitStyle}}split{{else}}unified{{end}}&whitespace={{$.WhitespaceBehavior}}&show-outdated={{$.ShowOutdatedComments}}">{{ctx.Locale.Tr "repo.pulls.show_all_commits"}}</a></div>
			</div>
		{{end}}
	{{end}}
	<div id="diff-container">
		{{if $showFileTree}}
			{{$.FileIconPoolHTML}}
			<div id="diff-file-tree" class="tw-hidden not-mobile" data-locale="{{JsonUtils.EncodeToString (dict
				"filterFiles" (ctx.Locale.Tr "repo.diff.filter_files")
				"filterFilesClear" (ctx.Locale.Tr "repo.diff.filter_files_clear")
				"filterOptions" (ctx.Locale.Tr "repo.diff.filter_options")
				"fileStatus" (ctx.Locale.Tr "repo.diff.file_status")
				"fileStatusAdded" (ctx.Locale.Tr "repo.diff.file_status_added")
				"fileStatusModified" (ctx.Locale.Tr "repo.diff.file_status_modified")
				"fileStatusDeleted" (ctx.Locale.Tr "repo.diff.file_status_deleted")
				"fileStatusRenamed" (ctx.Locale.Tr "repo.diff.file_status_renamed")
				"hasComments" (ctx.Locale.Tr "repo.diff.has_comments")
				"files" (ctx.Locale.Tr "files")
				"comments" (ctx.Locale.Tr "repo.diff.comments")
				"noComments" (ctx.Locale.Tr "repo.diff.no_comments")
				"outdated" (ctx.Locale.Tr "repo.issues.review.outdated")
				"pending" (ctx.Locale.Tr "repo.issues.review.pending")
				"resolved" (ctx.Locale.Tr "repo.diff.resolved")
				"fileExtensions" (ctx.Locale.Tr "repo.diff.file_extensions")
				"noFileExtension" (ctx.Locale.Tr "repo.diff.no_file_extension")
				"dotfileExtension" (ctx.Locale.Tr "repo.diff.dotfile_extension")
				"allFileExtensions" (ctx.Locale.Tr "repo.diff.all_file_extensions")
			)}}"></div>
			<script nonce="{{ctx.CspScriptNonce}}">
				if (diffTreeVisible) document.getElementById('diff-file-tree').classList.remove('tw-hidden');
			</script>
		{{end}}
		{{if .DiffNotAvailable}}
			<h4>{{ctx.Locale.Tr "repo.diff.data_not_available"}}</h4>
		{{else}}
			<div id="diff-boxes-column">
				{{if $showFileTree}}
					<div id="diff-no-matches" class="empty-placeholder tw-hidden">
						<h2>{{ctx.Locale.Tr "repo.diff.no_files_matched"}}</h2>
					</div>
				{{end}}
				<div id="diff-viewer" data-locale="{{JsonUtils.EncodeToString (dict
					"loadFailed" (ctx.Locale.Tr "repo.diff.data_not_available")
					"tooManyFiles" (ctx.Locale.TrString "repo.diff.too_many_files")
					"load" (ctx.Locale.Tr "repo.diff.load")
					"fileSuppressed" (ctx.Locale.Tr "repo.diff.file_suppressed")
					"bin" (ctx.Locale.Tr "repo.diff.bin")
					"binNotShown" (ctx.Locale.Tr "repo.diff.bin_not_shown")
					"renamedNoChanges" (ctx.Locale.Tr "repo.diff.file_renamed_no_changes")
					"modeChanged" (ctx.Locale.Tr "repo.diff.file_mode_changed")
					"whitespaceOnly" (ctx.Locale.Tr "repo.diff.file_whitespace_only_changes")
					"submoduleAdded" (ctx.Locale.TrString "repo.diff.submodule_added")
					"submoduleDeleted" (ctx.Locale.TrString "repo.diff.submodule_deleted")
					"submoduleUpdated" (ctx.Locale.TrString "repo.diff.submodule_updated")
					"copyPath" (ctx.Locale.Tr "copy_path")
					"viewed" (ctx.Locale.Tr "repo.pulls.has_viewed_file")
					"changedSinceLastReview" (ctx.Locale.Tr "repo.pulls.has_changed_since_last_review")
					"addLineComment" (ctx.Locale.Tr "repo.diff.comment.add_line_comment")
					"singleComment" (ctx.Locale.Tr "repo.diff.comment.add_single_comment")
					"cancel" (ctx.Locale.Tr "cancel")
					"commentedAt" (ctx.Locale.TrString "repo.issues.commented_at")
					"outdated" (ctx.Locale.Tr "repo.issues.review.outdated")
					"pending" (ctx.Locale.Tr "repo.issues.review.pending")
					"reply" (ctx.Locale.Tr "repo.diff.comment.reply")
					"resolve" (ctx.Locale.Tr "repo.issues.review.resolve_conversation")
					"unresolve" (ctx.Locale.Tr "repo.issues.review.un_resolve_conversation")
					"resolvedBy" (ctx.Locale.Tr "repo.issues.review.resolved_by")
					"showResolved" (ctx.Locale.Tr "repo.issues.review.show_resolved")
					"hideResolved" (ctx.Locale.Tr "repo.issues.review.hide_resolved")
					"previous" (ctx.Locale.Tr "repo.issues.previous")
					"next" (ctx.Locale.Tr "repo.issues.next")
					"outdatedDescription" (ctx.Locale.Tr "repo.issues.review.outdated_description")
					"pendingTooltip" (ctx.Locale.Tr "repo.issues.review.pending.tooltip" (ctx.Locale.Tr "repo.diff.review") (ctx.Locale.Tr "repo.diff.review.approve") (ctx.Locale.Tr "repo.diff.review.comment") (ctx.Locale.Tr "repo.diff.review.reject"))
					"review" (ctx.Locale.Tr "repo.issues.review.review")
					"noContent" (ctx.Locale.Tr "repo.issues.no_content")
					"migratedFrom" (ctx.Locale.TrString "repo.migrated_from")
					"copyLink" (ctx.Locale.Tr "copy_link")
					"copySource" (ctx.Locale.Tr "repo.issues.context.copy_source")
					"quoteReply" (ctx.Locale.Tr "repo.issues.context.quote_reply")
					"referenceIssue" (ctx.Locale.Tr "repo.issues.context.reference_issue")
					"edit" (ctx.Locale.Tr "repo.issues.context.edit")
					"delete" (ctx.Locale.Tr "repo.issues.context.delete")
					"deleteConfirm" (ctx.Locale.Tr "repo.issues.delete_comment_confirm")
					"blockUser" (ctx.Locale.Tr "user.block.block.user")
					"blockOrg" (ctx.Locale.Tr "user.block.block.org")
					"reactions" (ctx.Locale.Tr "repo.reactions")
					"reactionsMore" (ctx.Locale.TrString "repo.reactions_more")
					"openAttachment" (ctx.Locale.TrString "repo.issues.attachment.open_tab")
					"startReview" (ctx.Locale.Tr "repo.diff.comment.start_review")
					"addReviewComment" (ctx.Locale.Tr "repo.diff.comment.add_review_comment")
					"generated" (ctx.Locale.Tr "repo.diff.generated")
					"vendored" (ctx.Locale.Tr "repo.diff.vendored")
					"protected" (ctx.Locale.Tr "repo.diff.protected")
					"modeDirectory" (ctx.Locale.Tr "git.filemode.directory")
					"modeNormal" (ctx.Locale.Tr "git.filemode.normal_file")
					"modeExecutable" (ctx.Locale.Tr "git.filemode.executable_file")
					"modeSymlink" (ctx.Locale.Tr "git.filemode.symbolic_link")
					"modeSubmodule" (ctx.Locale.Tr "git.filemode.submodule")
					"modeChangedFormat" (ctx.Locale.TrString "git.filemode.changed_filemode")
					"escape" (ctx.Locale.Tr "repo.escape_control_characters")
					"unescape" (ctx.Locale.Tr "repo.unescape_control_characters")
					"copyFilename" (ctx.Locale.Tr "copy_filename")
					"viewFile" (ctx.Locale.Tr "repo.diff.view_file")
					"editFile" (ctx.Locale.Tr "repo.editor.edit_this_file")
					"numComments1" (ctx.Locale.TrString "repo.issues.num_comments_1")
					"numComments" (ctx.Locale.TrString "repo.issues.num_comments")
					"loading" (ctx.Locale.Tr "loading")
					"viewSource" (ctx.Locale.Tr "repo.file_view_source")
					"viewRendered" (ctx.Locale.Tr "repo.file_view_rendered")
					"sideBySide" (ctx.Locale.Tr "repo.diff.image.side_by_side")
					"swipe" (ctx.Locale.Tr "repo.diff.image.swipe")
					"overlay" (ctx.Locale.Tr "repo.diff.image.overlay")
					"fileBefore" (ctx.Locale.Tr "repo.diff.file_before")
					"fileAfter" (ctx.Locale.Tr "repo.diff.file_after")
					"imageWidth" (ctx.Locale.Tr "repo.diff.file_image_width")
					"imageHeight" (ctx.Locale.Tr "repo.diff.file_image_height")
					"byteSize" (ctx.Locale.Tr "repo.diff.file_byte_size")
					"csvTooLarge" (ctx.Locale.Tr "repo.error.csv.too_large")
					"csvUnexpected" (ctx.Locale.TrString "repo.error.csv.unexpected")
					"csvFieldCount" (ctx.Locale.TrString "repo.error.csv.invalid_field_count")
					"ambiguousRunesLine" (ctx.Locale.Tr "repo.ambiguous_runes_line")
					"invisibleRunesLine" (ctx.Locale.Tr "repo.invisible_runes_line")
					"ambiguousCharacter" (ctx.Locale.TrString "repo.ambiguous_character")
				)}}">
					<div class="diff-viewer-status flex-text-block tw-justify-center tw-p-8 tw-text-text-light">
						<span class="is-loading tw-size-4"></span>{{ctx.Locale.Tr "loading"}}
					</div>
				</div>
			</div>
		{{end}}
	</div>

	{{if and .PageIsPullFiles $.SignedUserID (not $.Repository.IsArchived) (not .DiffNotAvailable)}}
		<template id="diff-viewer-editor-template">
			<div class="field">
				{{template "shared/combomarkdowneditor" (dict
					"CustomInit" true
					"MarkdownEditorContext" (ctx.MiscUtils.MarkdownEditorComment .Repository)
					"TextareaName" "content"
					"TextareaPlaceholder" (ctx.Locale.Tr "repo.diff.comment.placeholder")
					"DropzoneParentContainer" "form"
					"DisableAutosize" "true"
				)}}
			</div>
			{{if .IsAttachmentEnabled}}
				<div class="field">
					{{template "repo/upload" dict "UploadOptions" .UploadOptions}}
				</div>
			{{end}}
		</template>
	{{end}}
	{{if and (not $.Repository.IsArchived) (not .DiffNotAvailable)}}
		<template id="issue-comment-editor-template">
			<form class="ui form comment">
				<div class="field">
				{{template "shared/combomarkdowneditor" (dict
					"CustomInit" true
					"MarkdownEditorContext" (ctx.MiscUtils.MarkdownEditorComment $.Repository)
					"TextareaName" "content"
					"DropzoneParentContainer" ".ui.form"
				)}}
				</div>
				{{if .IsAttachmentEnabled}}
					<div class="field">
						{{template "repo/upload" dict "UploadOptions" $.UploadOptions}}
					</div>
				{{end}}
				<div class="field flex-text-block tw-justify-end">
					<button type="button" class="ui cancel button">{{ctx.Locale.Tr "repo.issues.cancel"}}</button>
					<button type="submit" class="ui primary button">{{ctx.Locale.Tr "repo.issues.save"}}</button>
				</div>
			</form>
		</template>
	{{end}}
	{{if (not .DiffNotAvailable)}}
		{{template "repo/issue/view_content/reference_issue_dialog" .}}
		{{template "shared/user/block_user_dialog" .}}
	{{end}}
</div>
