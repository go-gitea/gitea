{{template "base/head" .}}

{{$showCreateWorkflowBadge := Iif .WorkflowBadge true false}}
{{$showEnableDisableWorkflow := and .AllowDisableOrEnableWorkflow .CurWorkflowIsListed $.CurWorkflow}}

<div class="page-content repository actions">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}

		{{if .HasWorkflowsOrRuns}}
		<div class="flex-container">
			{{template "repo/actions/sidebar" .}}
			<div class="flex-container-main">
				<div class="ui top attached header flex-left-right">
					<strong>{{ctx.Locale.TrN .Page.Paginator.Total "actions.runs.workflow_run_count_1" "actions.runs.workflow_run_count_n" .Page.Paginator.Total}}</strong>
					<div class="ui secondary filter menu flex-text-block tw-m-0">
						<!-- Actor -->
						<div class="dropdown-container">
							<button type="button" class="dropdown-trigger item"{{if not .Actors}} disabled{{end}}>{{ctx.Locale.Tr "actions.runs.actor"}} {{svg "octicon-triangle-down" 14}}</button>
							<div class="dropdown-popup">
								<input class="dropdown-filter" type="search" placeholder="{{ctx.Locale.Tr "actions.runs.actor"}}">
								<a class="dropdown-item{{if not $.CurActor}} active{{end}}" href="?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}&status={{$.CurStatus}}&branch={{$.CurBranch}}&actor=0">
									{{ctx.Locale.Tr "actions.runs.actors_no_select"}}
								</a>
								{{range .Actors}}
									<a class="dropdown-item{{if eq .ID $.CurActor}} active{{end}}" href="?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}&actor={{.ID}}&status={{$.CurStatus}}&branch={{$.CurBranch}}">
										{{ctx.AvatarUtils.Avatar . 20}} {{.GetDisplayName}}
									</a>
								{{end}}
							</div>
						</div>
						<!-- Status -->
						<div class="dropdown-container">
							<button type="button" class="dropdown-trigger item">{{ctx.Locale.Tr "actions.runs.status"}} {{svg "octicon-triangle-down" 14}}</button>
							<div class="dropdown-popup">
								<input class="dropdown-filter" type="search" placeholder="{{ctx.Locale.Tr "actions.runs.status"}}">
								<a class="dropdown-item{{if not $.CurStatus}} active{{end}}" href="?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}&actor={{$.CurActor}}&branch={{$.CurBranch}}&status=0">
									{{ctx.Locale.Tr "actions.runs.status_no_select"}}
								</a>
								{{range .StatusInfoList}}
									<a class="dropdown-item{{if eq .Status $.CurStatus}} active{{end}}" href="?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}&actor={{$.CurActor}}&status={{.Status}}&branch={{$.CurBranch}}">
										<span class="flex-text-inline tw-gap-2">
											{{template "repo/icons/action_status" (dict "Status" .StatusName)}}
											{{.DisplayedStatus}}
										</span>
									</a>
								{{end}}
							</div>
						</div>
						<!-- Branch -->
						<div class="dropdown-container" data-test-id="filter-branch">
							<button type="button" class="dropdown-trigger item"{{if not .RunBranches}} disabled{{end}}>{{ctx.Locale.Tr "actions.runs.branch"}} {{svg "octicon-triangle-down" 14}}</button>
							<div class="dropdown-popup">
								<input class="dropdown-filter" type="search" placeholder="{{ctx.Locale.Tr "actions.runs.branch"}}">
								<a class="dropdown-item{{if not $.CurBranch}} active{{end}}" href="?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}&actor={{$.CurActor}}&status={{$.CurStatus}}">
									{{ctx.Locale.Tr "actions.runs.branches_no_select"}}
								</a>
								{{range .RunBranches}}
									<a class="dropdown-item{{if eq . $.CurBranch}} active{{end}}" href="?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}&actor={{$.CurActor}}&status={{$.CurStatus}}&branch={{.}}">
										{{.}}
									</a>
								{{end}}
							</div>
						</div>

						{{if or $showCreateWorkflowBadge $showEnableDisableWorkflow}}
						<div class="dropdown-container" data-placement="bottom-end">
							<button type="button" class="dropdown-trigger btn interact-bg tw-p-2" aria-label="{{ctx.Locale.Tr "more_items"}}">{{svg "octicon-kebab-horizontal"}}</button>
							<div class="dropdown-popup">
								{{if $showCreateWorkflowBadge}}
								<div class="dropdown-item show-modal" data-modal="#workflow-status-badge-modal">
									{{ctx.Locale.Tr "actions.workflow.create_status_badge"}}
								</div>
								{{end}}
								{{if $showEnableDisableWorkflow}}
								<a class="dropdown-item{{if not .CurWorkflowRequired}} link-action{{end}}"{{if .CurWorkflowRequired}} aria-disabled="true"{{end}}{{if not .CurWorkflowRequired}} data-url="{{$.Link}}/{{if .CurWorkflowDisabled}}enable{{else}}disable{{end}}?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}&actor={{.CurActor}}&status={{$.CurStatus}}&branch={{$.CurBranch}}"{{end}}>
									{{if .CurWorkflowRequired}}{{ctx.Locale.Tr "actions.workflow.disable"}}{{else if .CurWorkflowDisabled}}{{ctx.Locale.Tr "actions.workflow.enable"}}{{else}}{{ctx.Locale.Tr "actions.workflow.disable"}}{{end}}
								</a>
								{{end}}
							</div>
						</div>
						{{end}}
					</div>
				</div>

				{{if .WorkflowDispatchConfig}}
					{{template "repo/actions/workflow_dispatch" .}}
				{{end}}

				<div class="ui attached segment">
					{{template "repo/actions/runs_list" dict "ActionRunListData" $.ActionRunListData}}
					{{template "base/paginate" dict "Page" $.Page}}
				</div>
			</div>
		</div>
		{{else}}
			{{template "repo/actions/no_workflows" .}}
		{{end}}
	</div>
</div>

{{if $showCreateWorkflowBadge}}
<dialog id="workflow-status-badge-modal" class="modal-dialog">
	<div class="header">{{ctx.Locale.Tr "actions.workflow.status_badge"}}</div>
	<div class="content">
		<div class="ui form" data-global-init="initWorkflowBadgeForm"
				data-badge-url="{{.WorkflowBadge.BadgeURL}}"
				data-workflow-url="{{.WorkflowBadge.WorkflowURL}}"
				data-workflow-display-name="{{.WorkflowBadge.DisplayName}}"
		>
			<div class="field">
				<img data-workflow-badge-image src="{{.WorkflowBadge.BadgeURL}}" alt="{{.CurWorkflow}}">
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "actions.runs.branch"}}</label>
				<select data-workflow-badge-branch>
					<option value="{{.Repository.DefaultBranch}}" selected>{{.Repository.DefaultBranch}}</option>
					{{range $branchName := .RunBranches}}
						{{if ne $branchName $.Repository.DefaultBranch}}
							<option value="{{$branchName}}">{{$branchName}}</option>
						{{end}}
					{{end}}
				</select>
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "actions.workflow.status_badge_url"}}</label>
				<div class="ui action input">
					<input id="workflow-badge-url" readonly autofocus>
					<button type="button" class="ui icon button" data-tooltip-content="{{ctx.Locale.Tr "copy"}}" data-clipboard-target="#workflow-badge-url">{{svg "octicon-copy" 14}}</button>
				</div>
			</div>
			<div class="field">
				<label>Markdown</label>
				<textarea id="workflow-badge-markdown" rows="2" readonly></textarea>
			</div>
			<div class="field">
				<label>HTML</label>
				<textarea id="workflow-badge-html" rows="2" readonly></textarea>
			</div>
		</div>
	</div>
</dialog>
{{end}}

{{template "base/footer" .}}
