{{template "base/head" .}}

<div class="page-content repository actions">
	<div class="ui fluid container artifact-preview-page">
		{{template "base/alert" .}}
		{{$data := .ArtifactPreviewData}}
		<div class="artifact-preview-header">
			<a class="artifact-preview-back" href="{{$data.RunURL}}">
				{{svg "octicon-arrow-left" 14}}
				{{if $data.RunAttempt}}
					{{ctx.Locale.Tr "actions.artifacts.back_to_run_attempt" $data.RunIndex $data.RunAttempt}}
				{{else}}
					{{ctx.Locale.Tr "actions.artifacts.back_to_run" $data.RunIndex}}
				{{end}}
			</a>
			<div class="artifact-preview-summary">
				<h2 class="artifact-preview-title">{{ctx.Locale.Tr "preview"}}: {{$data.ArtifactName}}</h2>
				<a class="ui button" href="{{$data.DownloadURL}}">
					{{svg "octicon-download"}}
					{{ctx.Locale.Tr "repo.download_file"}}
				</a>
			</div>
		</div>

		<div class="artifact-preview-layout {{if $data.ShowPreviewContent}}artifact-preview-layout-with-content{{end}}">
			<div class="artifact-preview-browser">
				<div class="artifact-preview-browser-title">{{ctx.Locale.Tr "files"}}</div>
				{{if $data.PreviewTooLarge}}
					<div class="ui warning message">{{ctx.Locale.Tr "actions.artifacts.preview_artifact_too_large"}}</div>
				{{end}}
				{{if $data.RequestedPathMissing}}
					<div class="ui warning message">{{ctx.Locale.Tr "actions.artifacts.preview_file_not_found"}}</div>
				{{end}}
				{{if $data.PreviewFilesTruncated}}
					<div class="ui info message">{{ctx.Locale.Tr "actions.artifacts.preview_file_list_truncated"}}</div>
				{{end}}
				<div class="artifact-preview-file-list">
					{{range $file := $data.PreviewFiles}}
						{{if $file.IsDir}}
							<div class="artifact-preview-file-row artifact-preview-file-row-directory artifact-preview-depth-{{$file.Depth}}" title="{{$file.Path}}">
								{{svg "octicon-file-directory" 16}}
								<span class="gt-ellipsis">{{$file.Name}}</span>
							</div>
						{{else}}
							<a class="artifact-preview-file-row artifact-preview-file-row-file artifact-preview-depth-{{$file.Depth}} {{if $file.Selected}}active{{end}}" href="{{$file.Link}}" title="{{$file.Path}}">
								{{svg "octicon-file" 16}}
								<span class="gt-ellipsis">{{$file.Name}}</span>
							</a>
						{{end}}
					{{else}}
						<div class="artifact-preview-file-row disabled">{{ctx.Locale.Tr "actions.artifacts.preview_no_files"}}</div>
					{{end}}
				</div>
			</div>

			{{if $data.ShowPreviewContent}}
				<div class="artifact-preview-content">
					<div class="ui warning message tw-mt-0">{{ctx.Locale.Tr "actions.artifacts.preview_generated_content"}}</div>
					<iframe class="artifact-preview-frame" src="{{$data.PreviewContentURL}}" {{if not $data.PreviewIsPDF}}sandbox="allow-scripts" {{end}}referrerpolicy="no-referrer"></iframe>
				</div>
			{{end}}
		</div>
	</div>
</div>

{{template "base/footer" .}}
