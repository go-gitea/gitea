{{/* "z-index" is used to maintain continuous attached styling and keep the colored border-bottom visible (pre-existing fomantic issue with negative margins) */}}
<div class="ui blue info attached message flex-left-right tw-z-1">
	<span>{{ctx.Locale.Tr "actions.workflow.has_workflow_dispatch"}}</span>
	<div class="flex-text-block tw-bg-box-body tw-rounded">{{/*make the button have correct hovered color */}}
		<button type="button" class="ui mini button show-modal" data-modal="#runWorkflowDispatchModal">{{ctx.Locale.Tr "actions.workflow.run"}}{{svg "octicon-triangle-down" 14}}</button>
	</div>
</div>
<dialog id="runWorkflowDispatchModal" class="modal-dialog">
	<div class="content">
		<form id="runWorkflowDispatchForm" class="ui form ignore-dirty" action="{{$.Link}}/run?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}&actor={{$.CurActor}}&status={{$.CurStatus}}&branch={{$.CurBranch}}" method="post">
			<div class="ui inline field required tw-flex tw-items-center">
				<span class="ui inline required field">
					<label>{{ctx.Locale.Tr "actions.workflow.from_ref"}}:</label>
				</span>
				<div class="dropdown-container select-branch" data-kind="select">
					<button type="button" class="dropdown-trigger ui button">
						{{svg "octicon-git-branch" 14}}
						<span class="dropdown-text">{{index .Branches 0}}</span>
						{{svg "octicon-triangle-down" 14}}
					</button>
					<input type="hidden" class="dropdown-value" name="ref" value="refs/heads/{{index .Branches 0}}"
								data-fetch-trigger="change" data-fetch-sync="$body #runWorkflowDispatchModalInputs"
								data-fetch-url="{{$.Link}}/workflow-dispatch-inputs?workflow={{$.CurWorkflow}}&scoped_workflow_source_repo_id={{$.CurWorkflowRepoID}}"
					>
					<div class="dropdown-popup issue-branch-popup">
						<input class="dropdown-filter" type="search" placeholder="{{ctx.Locale.Tr "repo.filter_branch_and_tag"}}...">
						<div class="branch-tag-tab flex-text-block">
							<button type="button" class="btn branch-tag-item active" data-target=".branch-list">
								{{svg "octicon-git-branch" 16}} {{ctx.Locale.Tr "repo.branches"}}
							</button>
							<button type="button" class="btn branch-tag-item" data-target=".tag-list">
								{{svg "octicon-tag" 16}} {{ctx.Locale.Tr "repo.tags"}}
							</button>
						</div>
						<div class="reference-list-menu branch-list">
							{{range .Branches}}
								<div class="dropdown-item" data-value="refs/heads/{{.}}" title="{{.}}">{{.}}</div>
							{{end}}
						</div>
						<div class="reference-list-menu tag-list tw-hidden">
							{{range .Tags}}
								<div class="dropdown-item" data-value="refs/tags/{{.}}" title="{{.}}">{{.}}</div>
							{{end}}
						</div>
					</div>
				</div>
			</div>
			<div class="divider"></div>
			{{template "repo/actions/workflow_dispatch_inputs" .}}
		</form>
	</div>
</dialog>
