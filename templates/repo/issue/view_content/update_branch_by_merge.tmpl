{{$data := $.MergeBoxData}}
{{$hasStyleMenu := gt (len $data.UpdateStyleOptions) 1}}
<div class="ui buttons"{{if $hasStyleMenu}} data-global-init="initRepoPullRequestUpdate"{{end}}>
	<button type="button" class="ui button link-action" data-url="{{$data.UpdatePrimaryAction.URL}}">
		{{$data.UpdatePrimaryAction.ButtonText}}
	</button>
	{{if $hasStyleMenu}}
	<button type="button" class="ui icon button" aria-label="{{ctx.Locale.Tr "repo.pulls.select_update_style"}}">{{svg "octicon-triangle-down" 14}}</button>
	{{end}}
</div>
{{if $hasStyleMenu}}
<div class="tippy-target merge-box-menu">
	{{range $data.UpdateStyleOptions}}
		<a class="item" role="menuitemradio" aria-checked="{{.Selected}}" data-update-url="{{.URL}}" data-update-text="{{.ButtonText}}">
			{{svg "octicon-check"}}
			<div><strong>{{.Text}}</strong><small>{{.Description}}</small></div>
		</a>
	{{end}}
</div>
{{end}}
