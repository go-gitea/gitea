{{$data := $.MergeBoxData}}
<div class="tw-w-full flex-left-right">
	<div class="flex-text-block">
		{{svg "octicon-alert"}}
		{{ctx.Locale.Tr "repo.pulls.outdated_with_base_branch"}}
	</div>
	{{if $data.UpdatePrimaryAction}}
	<div class="ui buttons"{{if $data.UpdateStyleOptions}} data-global-init="initRepoPullRequestUpdate"{{end}}>
		<button type="button" class="ui button link-action" data-url="{{$data.UpdatePrimaryAction.URL}}">
			{{$data.UpdatePrimaryAction.Text}}
		</button>
		{{if gt (len $data.UpdateStyleOptions) 1}}
		<div class="dropdown-container">
			<button type="button" class="dropdown-trigger ui icon button" aria-label="{{ctx.Locale.Tr "more_items"}}">{{svg "octicon-triangle-down"}}</button>
			<div class="dropdown-popup dropdown-popup-button">
				{{range $data.UpdateStyleOptions}}
					<button type="button" class="dropdown-item {{if .Selected}}active{{end}}" data-update-url="{{.URL}}">{{.Text}}</button>
				{{end}}
			</div>
		</div>
		{{end}}
	</div>
	{{end}}
</div>
