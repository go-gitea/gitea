{{$data := $.MergeBoxData}}
{{$hasStyleMenu := gt (len $data.UpdateStyleOptions) 1}}
<div class="ui buttons {{if $hasStyleMenu}}pull-update-style-buttons{{end}}">
	<button type="button" class="ui button link-action" data-url="{{$data.UpdatePrimaryAction.URL}}">
		{{$data.UpdatePrimaryAction.ButtonText}}
	</button>
	{{if $hasStyleMenu}}
	<button type="button" class="ui icon button" aria-label="{{ctx.Locale.Tr "repo.pulls.select_update_style"}}">{{svg "octicon-triangle-down" 14}}</button>
	{{end}}
</div>
{{if $hasStyleMenu}}
<div class="tippy-target merge-box-menu">
	{{range $option := $data.UpdateStyleOptions}}
		<a class="item" role="menuitemradio" aria-checked="{{$option.Selected}}" data-update-url="{{$option.URL}}" data-update-text="{{$option.ButtonText}}">
			{{svg "octicon-check"}}
			<div><strong>{{$option.Text}}</strong><small>{{$option.Description}}</small></div>
		</a>
	{{end}}
</div>
{{end}}
