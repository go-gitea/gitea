{{$type := $.ConvContentType -}}
{{$item := $.ConvContentItem -}}
{{$page := $.ConvContentPage -}}

{{$isCommitComment := eq $type "commit_comment" -}}
{{$isPagePrFiles := eq $page "pr-files" -}}
{{$isCommentPoster := and ctx.RootData.IsSigned (eq ctx.RootData.SignedUserID $item.PosterID) -}}

{{$referenceHTMLURL := "" -}}
{{$deleteURL := "" -}}
{{$canEditContent := false -}}
{{$canDelete := false -}}
{{if $isCommitComment -}}
	{{/* commit comments live on the commit page, have no edit endpoint and carry their own delete permission */}}
	{{$referenceHTMLURL = printf "%s/commit/%s#%s" (ctx.RootData.Repository.HTMLURL ctx) $item.CommitSHA $item.HashTag -}}
	{{$deleteURL = printf "%s/commit/%s/comment/%d/delete" ctx.RootData.RepoLink $item.CommitSHA $item.ID -}}
	{{$canDelete = $item.CanDelete -}}
{{else -}}
	{{$referenceHTMLURL = printf "%s%s#%s" (ctx.RootData.Issue.HTMLURL ctx) (Iif $isPagePrFiles "/files" "") $item.HashTag -}}
	{{$canEditContent = or ctx.RootData.Permission.IsAdmin ctx.RootData.HasIssuesOrPullsWritePermission $isCommentPoster -}}
	{{if eq $type "issue_comment" -}}
		{{$deleteURL = printf "%s/comments/%d/delete" ctx.RootData.RepoLink $item.ID -}}
		{{$canDelete = $canEditContent -}}
	{{end -}}
{{end -}}

<div class="item action ui dropdown jump pointing top right">
	{{svg "octicon-kebab-horizontal"}}
	<div class="menu">
		<div class="item js-aria-clickable" data-clipboard-text="{{$referenceHTMLURL}}">{{ctx.Locale.Tr "copy_link"}}</div>
		<div class="item js-aria-clickable" data-clipboard-target="#{{$item.HashTag}}-raw">{{ctx.Locale.Tr "repo.issues.context.copy_source"}}</div>

		{{if ctx.RootData.IsSigned}}
			{{if not ctx.RootData.Repository.IsArchived}}
				<div class="item js-aria-clickable" data-global-click="onConvContentQuoteReply" data-shortcut-keys="r" data-shortcut-handler="quoteSelectedReply" data-target="{{$item.HashTag}}-raw">{{ctx.Locale.Tr "repo.issues.context.quote_reply"}}</div>
				{{if and (not $isCommitComment) (not ctx.Consts.RepoUnitTypeIssues.UnitGlobalDisabled)}}
					<div class="item js-aria-clickable reference-issue" data-target="{{$item.HashTag}}-raw" data-modal="#reference-issue-modal" data-poster="{{$item.Poster.GetDisplayName}}" data-poster-username="{{$item.Poster.Name}}" data-reference="{{$referenceHTMLURL}}">{{ctx.Locale.Tr "repo.issues.context.reference_issue"}}</div>
				{{end}}
				{{if or $canEditContent $canDelete}}
					<div class="divider"></div>
					{{if $canEditContent}}
						<div class="item js-aria-clickable" data-global-click="onConvContentEdit">{{ctx.Locale.Tr "repo.issues.context.edit"}}</div>
					{{end}}
					{{if $canDelete}}
						<div class="item js-aria-clickable" data-global-click="onConvContentDelete" data-comment-hash-tag={{$item.HashTag}} data-url="{{$deleteURL}}" data-locale="{{ctx.Locale.Tr "repo.issues.delete_comment_confirm"}}">{{ctx.Locale.Tr "repo.issues.context.delete"}}</div>
					{{end}}
				{{end}}
			{{end}}

			{{$canUserBlock := call ctx.RootData.CanBlockUser ctx.RootData.SignedUser $item.Poster -}}
			{{$canOrgBlock := and ctx.RootData.Repository.Owner.IsOrganization (call ctx.RootData.CanBlockUser ctx.RootData.Repository.Owner $item.Poster) -}}
			{{if or $canOrgBlock $canUserBlock}}
				<div class="divider"></div>
				{{if $canUserBlock}}
				<div class="item js-aria-clickable show-modal" data-modal="#block-user-modal" data-modal-modal-blockee="{{$item.Poster.Name}}" data-modal-modal-blockee-name="{{$item.Poster.GetDisplayName}}" data-modal-modal-form.url="{{AppSubUrl}}/user/settings/blocked_users">{{ctx.Locale.Tr "user.block.block.user"}}</div>
				{{end}}
				{{if $canOrgBlock}}
				<div class="item js-aria-clickable show-modal" data-modal="#block-user-modal" data-modal-modal-blockee="{{$item.Poster.Name}}" data-modal-modal-blockee-name="{{$item.Poster.GetDisplayName}}" data-modal-modal-form.url="{{ctx.RootData.Repository.Owner.OrganisationLink}}/settings/blocked_users">{{ctx.Locale.Tr "user.block.block.org"}}</div>
				{{end}}
			{{end}}
		{{end}}
	</div>
</div>
