{{$data := $.PullMergeBoxData}}
{{if $data.ShowMergeBox}}
<div class="timeline-item comment pull-merge-box"
	data-global-init="initRepoPullMergeBox"
	{{if $data.ReloadingInterval}}
		data-pull-merge-box-reloading-interval="{{$data.ReloadingInterval}}"
		data-pull-link="{{$.Issue.Link}}"
	{{end}}
>
	<div class="timeline-avatar merge-box-icon{{if .Issue.PullRequest.HasMerged}} tw-bg-purple{{else if $data.IsReady}} tw-bg-green{{end}}">{{svg "octicon-git-merge" 24}}</div>
	<div class="content">
		<div class="ui segment fitted{{if .Issue.PullRequest.HasMerged}} tw-border-purple{{else if $data.IsReady}} tw-border-green{{end}}">
			<div class="merge-section flex-divided-list items-with-main">
			{{with $data.ReviewSection}}
				<div class="item">{{template "repo/issue/view_content/pull_merge_section" .}}</div>
			{{end}}
			{{with $data.StatusCheckData}}
				{{template "repo/issue/view_content/pull_merge_status_checks" (dict "StatusCheckData" $data.StatusCheckData)}}
			{{end}}
			{{with $data.MergeSection}}
				<div class="item">
					{{template "repo/issue/view_content/pull_merge_section" .}}
					{{if $data.ShowUpdatePullInfo}}{{template "repo/issue/view_content/update_branch_by_merge" (dict "MergeBoxData" $data)}}{{end}}
					{{if and $.Issue.IsClosed $data.IsPullBranchDeletable}}
						<button type="button" class="ui button link-action delete-branch-after-merge" data-url="{{$.DeleteBranchLink}}">{{ctx.Locale.Tr "repo.branch.delete_html"}}</button>
					{{end}}
				</div>
			{{end}}
			{{with $data.BlockedSection}}
				<div class="item">{{template "repo/issue/view_content/pull_merge_section" .}}</div>
			{{end}}
			{{with $data.WorkInProgressSection}}
				<div class="item">
					{{template "repo/issue/view_content/pull_merge_section" .}}
					{{if or $.HasIssuesOrPullsWritePermission $.IsIssuePoster}}
						<button type="button" class="ui button" data-global-init="initPullRequestWipToggle" data-title="{{$.Issue.Title}}" data-wip-prefix="{{$.WorkInProgressPrefix}}" data-update-url="{{$.Issue.Link}}/title">
							<span>{{ctx.Locale.Tr "repo.pulls.remove_prefix" $.WorkInProgressPrefix}}</span>
						</button>
					{{end}}
				</div>
			{{end}}
			{{if or $data.AutoMerge $data.MergeFormProps $data.ShowPullCommands}}
				<div class="item merge-box-footer">
					{{if $data.AutoMerge}}
						{{if $data.CanCancelAutoMerge}}
							<button type="button" class="ui button link-action" data-url="{{$.Issue.Link}}/cancel_auto_merge">{{ctx.Locale.Tr "repo.pulls.auto_merge_cancel_schedule"}}</button>
						{{end}}
						<span class="merge-box-auto-merge-text">{{ctx.Locale.Tr "repo.pulls.auto_merge_enabled_desc" $data.AutoMerge.Doer.GetDisplayName (ctx.Locale.Tr (print "repo.pulls.merge_style_short." $data.AutoMerge.MergeStyle))}}</span>
					{{else if $data.MergeFormProps}}
						<div id="pull-request-merge-form" data-merge-form-props="{{JsonUtils.EncodeToString $data.MergeFormProps}}"></div>
					{{else}}
						<span class="merge-box-cmd-hint">{{ctx.Locale.Tr "repo.pulls.cmd_instruction_merge_hint"}} <a class="show-modal" href data-modal="#pull-merge-cmd-modal">{{ctx.Locale.Tr "repo.pulls.cmd_instruction_hint"}}</a></span>
					{{end}}
				</div>
			{{end}}
			</div>
			{{if $data.ShowPullCommands}}
				{{template "repo/issue/view_content/pull_merge_instruction" dict "PullRequest" .Issue.PullRequest "MergeBoxData" $data}}
			{{end}}
		</div>
	</div>
</div>
{{end}}
