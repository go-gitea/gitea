{{$mergeBoxData := $.PullMergeBoxData}}
{{$issue := $.Issue}}
{{$queued := $mergeBoxData.IsQueued}}
<div class="timeline-item comment pull-merge-box"
	data-global-init="initRepoPullMergeBox"
	{{if $queued}}data-pull-merge-queued{{end}}
	{{if $mergeBoxData.ReloadingInterval}}
		data-pull-merge-box-reloading-interval="{{$mergeBoxData.ReloadingInterval}}"
		data-pull-link="{{$issue.Link}}"
	{{end}}
>
	<div class="timeline-avatar merge-box-icon{{if $issue.PullRequest.HasMerged}} tw-bg-purple{{else if $queued}} tw-bg-yellow{{else if $mergeBoxData.IsMergeStateClean}} tw-bg-green{{end}}">{{svg (Iif $queued "octicon-git-merge-queue" "octicon-git-merge") 24}}</div>
	<div class="content">
		<div class="ui segment fitted tw-overflow-hidden{{if $issue.PullRequest.HasMerged}} tw-border-purple{{else if $queued}} tw-border-yellow{{else if $mergeBoxData.IsMergeStateClean}} tw-border-green{{end}}">
			<div class="merge-section flex-divided-list items-with-main">
			{{if $mergeBoxData.ReviewSection}}
				<div class="item">{{template "repo/issue/view_content/pull_merge_section" (dict "MergeBoxSection" $mergeBoxData.ReviewSection)}}</div>
			{{end}}
			{{if $mergeBoxData.StatusCheckData}}
				{{template "repo/issue/view_content/pull_merge_status_checks" (dict "StatusCheckData" $mergeBoxData.StatusCheckData)}}
			{{end}}
			<div class="item">
				{{template "repo/issue/view_content/pull_merge_section" (dict "MergeBoxSection" $mergeBoxData.MergeSection)}}
				{{if and $mergeBoxData.ShowUpdatePullInfo $mergeBoxData.UpdatePrimaryAction}}{{template "repo/issue/view_content/update_branch_by_merge" (dict "UpdatePrimaryAction" $mergeBoxData.UpdatePrimaryAction "UpdateStyleOptions" $mergeBoxData.UpdateStyleOptions)}}{{end}}
				{{if $mergeBoxData.IsPullBranchDeletable}}
					<button type="button" class="ui button link-action delete-branch-after-merge tw-shrink-0" data-url="{{$.DeleteBranchLink}}">{{ctx.Locale.Tr "repo.branch.delete_html"}}</button>
				{{end}}
				{{if $mergeBoxData.CanDequeue}}
					<button type="button" class="ui button link-action tw-shrink-0"
						{{template "repo/pulls/merge_queue_action_attrs" dict "url" (print $issue.Link "/merge_queue/remove") "action" "remove"}}
					>{{ctx.Locale.Tr "repo.pulls.merge_queue.remove"}}</button>
				{{end}}
			</div>
			{{if $mergeBoxData.BlockedSection}}
				<div class="item">{{template "repo/issue/view_content/pull_merge_section" (dict "MergeBoxSection" $mergeBoxData.BlockedSection)}}</div>
			{{end}}
			{{if $mergeBoxData.WorkInProgressSection}}
				<div class="item">
					{{template "repo/issue/view_content/pull_merge_section" (dict "MergeBoxSection" $mergeBoxData.WorkInProgressSection)}}
					{{if or $.HasIssuesOrPullsWritePermission $.IsIssuePoster}}
					<button type="button" class="ui button tw-shrink-0" data-global-init="initPullRequestWipToggle" data-title="{{$issue.Title}}" data-wip-prefix="{{$.WorkInProgressPrefix}}" data-update-url="{{$issue.Link}}/title">
						{{ctx.Locale.Tr "repo.pulls.remove_prefix" $.WorkInProgressPrefix}}
					</button>
					{{end}}
				</div>
			{{end}}
			{{if or $mergeBoxData.AutoMerge $mergeBoxData.MergeFormProps $mergeBoxData.ShowPullCommands}}
				<div class="item merge-box-footer tw-items-center tw-bg-box-header">
					{{if $mergeBoxData.AutoMerge}}
						{{if $mergeBoxData.CanCancelAutoMerge}}
							<button type="button" class="ui button link-action tw-shrink-0" data-url="{{$issue.Link}}/cancel_auto_merge">{{ctx.Locale.Tr "repo.pulls.auto_merge_cancel_schedule"}}</button>
						{{end}}
					{{else if $mergeBoxData.MergeFormProps}}
						{{/* The merge form is a Vue component, these invisible copies of its initial rows avoid layout shifting until it is mounted */}}
						<div class="tw-flex-auto tw-min-w-0" data-merge-form-props="{{JsonUtils.EncodeToString $mergeBoxData.MergeFormProps}}">
							{{if $mergeBoxData.MergeFormProps.canBypassMerge}}<div class="ui checkbox tw-flex tw-mb-4 tw-invisible"><label>{{$mergeBoxData.MergeFormProps.textBypassRules}}</label></div>{{end}}
							<div class="flex-text-block tw-flex-wrap tw-invisible">
								<div class="ui buttons"><button type="button" class="ui button">&nbsp;</button></div>
								<span class="merge-box-footer-text">{{with $mergeBoxData.MergeFormProps.queue}}{{ctx.Locale.Tr "repo.pulls.merge_queue.help" .linkText .branch}}{{else}}{{$mergeBoxData.MergeFormProps.textCmdMergeHint}}{{end}} {{$mergeBoxData.MergeFormProps.textCmdInstructions}}</span>
							</div>
						</div>
					{{end}}
					{{if or $mergeBoxData.AutoMerge (not $mergeBoxData.MergeFormProps)}}
						<span class="merge-box-footer-text">
							{{if $mergeBoxData.AutoMerge}}
								{{if $mergeBoxData.MergeQueueLink}}{{ctx.Locale.Tr "repo.pulls.merge_queue.auto_merge_desc" $mergeBoxData.AutoMerge.Doer.GetDisplayName}}
								{{else}}{{ctx.Locale.Tr "repo.pulls.auto_merge_enabled_desc" $mergeBoxData.AutoMerge.Doer.GetDisplayName $mergeBoxData.AutoMergeStyleName}}{{end}}
							{{end}}
							{{if $mergeBoxData.ShowPullCommands}}
								<span class="tw-text-text-light">
									{{if $mergeBoxData.ShowMergeInstructions}}{{ctx.Locale.Tr "repo.pulls.cmd_instruction_merge_hint"}}{{end}}
									<button type="button" class="interact-link show-modal" data-modal="#pull-merge-cmd-modal">{{ctx.Locale.Tr "repo.pulls.cmd_instruction_hint"}}</button>
								</span>
							{{end}}
						</span>
					{{end}}
				</div>
			{{end}}
			</div>
		</div>
	</div>
</div>
