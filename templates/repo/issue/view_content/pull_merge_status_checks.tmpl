{{/* Template Attributes:
* StatusCheckData: see backend pullCommitStatusCheckData struct
*/}}
{{$statusCheckData := $.StatusCheckData}}
<details class="item merge-box-checks" data-kind="checks"{{if not $statusCheckData.AllPassed}} open{{end}}>
	<summary class="flex-text-block tw-items-start hover:tw-bg-hover">
		{{template "repo/issue/view_content/pull_merge_section" (dict "MergeBoxSection" ($statusCheckData.Section ctx.Locale))}}
		{{svg "octicon-chevron-right" 16 "merge-box-chevron tw-mt-2 tw-mr-[8px]"}}
	</summary>
	<div class="merge-box-checks-body tw-max-h-[300px] tw-overflow-y-auto tw-border-t tw-border-secondary">
		{{if and $statusCheckData.RequireApprovalRunCount $statusCheckData.CanApprove}}
			<div id="approve-status-checks" class="tw-py-2 tw-px-[16px]">
				<button type="button" class="ui basic button link-action" data-url="{{$statusCheckData.ApproveLink}}">
					{{ctx.Locale.Tr "repo.pulls.status_checks_approve_all"}}
				</button>
			</div>
		{{end}}
		{{range $group := $statusCheckData.Groups}}
		<details class="merge-box-checks-group" data-kind="{{$group.Kind.Name}}" open>
			<summary class="flex-text-inline tw-py-1 tw-px-[16px] tw-text-12 tw-font-medium tw-text-text-light-2">{{$group.Title ctx.Locale}}{{svg "octicon-chevron-right" 12 "merge-box-chevron"}}</summary>
			<div class="flex-divided-list tw-px-[16px]">
				{{range $check := $group.Checks}}
				<div class="item commit-status-item">
					<div class="flex-text-block tw-flex-1">
						{{if $check.ActionStatus}}
							{{template "repo/icons/action_status" (dict "Status" $check.ActionStatus "Size" 18 "ClassName" "commit-status icon")}}
						{{else}}
							{{template "repo/icons/commit_status" (dict "State" $check.State)}}
						{{end}}
						<span class="gt-ellipsis" title="{{$check.Context}} {{$check.Description}}">{{if $check.TargetURL}}<a class="muted" href="{{$check.TargetURL}}">{{$check.Context}}</a>{{else}}{{$check.Context}}{{end}} <span class="tw-text-12 tw-text-text-light-2">{{$check.Description}}</span></span>
					</div>
					{{if $check.IsRequired}}
						<div class="ui basic label tw-py-0 tw-leading-[18px]">{{ctx.Locale.Tr "repo.pulls.status_checks_requested"}}</div>
					{{end}}
				</div>
				{{end}}
			</div>
		</details>
		{{end}}
	</div>
</details>
