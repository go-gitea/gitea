{{/* Template Attributes:
* StatusCheckData: see backend pullCommitStatusCheckData struct
*/}}
{{$statusCheckData := $.StatusCheckData}}
<details class="item merge-box-checks"{{if not $statusCheckData.AllPassed}} open{{end}}>
	<summary>
		{{template "repo/issue/view_content/pull_merge_section" ($statusCheckData.Section ctx.Locale)}}
		{{svg "octicon-chevron-right" 16 "merge-box-chevron"}}
	</summary>
	<div class="merge-box-checks-body">
		{{if $statusCheckData.RequireApprovalRunCount}}
		<div class="flex-left-right" id="approve-status-checks">
			<div>
				<strong>{{ctx.Locale.TrN $statusCheckData.RequireApprovalRunCount "repo.pulls.status_checks_need_approvals_1" "repo.pulls.status_checks_need_approvals_n" $statusCheckData.RequireApprovalRunCount}}</strong>
				<div class="tw-text-text-light-2">{{ctx.Locale.Tr "repo.pulls.status_checks_need_approvals_helper"}}</div>
			</div>
			{{if $statusCheckData.CanApprove}}
			<button type="button" class="ui basic button link-action" data-url="{{$statusCheckData.ApproveLink}}">
				{{ctx.Locale.Tr "repo.pulls.status_checks_approve_all"}}
			</button>
			{{end}}
		</div>
		{{end}}
		{{range $group := $statusCheckData.Groups}}
		<details class="merge-box-checks-group" open>
			<summary>{{$group.Title ctx.Locale}}{{svg "octicon-chevron-right" 12 "merge-box-chevron"}}</summary>
			<div class="flex-divided-list">
				{{range $cs := $group.CommitStatuses}}
				<div class="item commit-status-item">
					<div class="flex-text-block">
						{{$actionStatus := $statusCheckData.ActionsStatuses.IconStatus $cs}}
						{{if $actionStatus}}
							{{template "repo/icons/action_status" (dict "Status" $actionStatus "Size" 18 "ClassName" "commit-status icon")}}
						{{else}}
							{{template "repo/icons/commit_status" $cs}}
						{{end}}
						<span class="gt-ellipsis" title="{{$cs.Context}} {{$cs.Description}}">{{if $cs.TargetURL}}<a class="muted" href="{{$cs.TargetURL}}">{{$cs.Context}}</a>{{else}}{{$cs.Context}}{{end}} <span class="check-description">{{$cs.Description}}</span></span>
					</div>
					{{if call $statusCheckData.IsContextRequired $cs.Context}}
						<div class="ui basic label">{{ctx.Locale.Tr "repo.pulls.status_checks_requested"}}</div>
					{{end}}
				</div>
				{{end}}
			</div>
		</details>
		{{end}}
	</div>
</details>
