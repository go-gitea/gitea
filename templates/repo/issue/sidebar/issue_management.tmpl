{{if and .IsRepoAdmin (not .Repository.IsArchived)}}
	<div class="divider"></div>

	{{/* Pin issue */}}
	{{if or .PinEnabled .Issue.IsPinned}}
		<form class="tw-mt-1 form-fetch-action single-button-form" method="post" {{if $.NewPinAllowed}}action="{{.Issue.Link}}/pin"{{else}}data-tooltip-content="{{ctx.Locale.Tr "repo.issues.max_pinned"}}"{{end}}>
			<button type="submit" class="fluid ui button {{if not $.NewPinAllowed}}disabled{{end}}">
				{{if not .Issue.IsPinned}}
					{{svg "octicon-pin"}}
					{{ctx.Locale.Tr "pin"}}
				{{else}}
					{{svg "octicon-pin-slash"}}
					{{ctx.Locale.Tr "unpin"}}
				{{end}}
			</button>
		</form>
	{{end}}

	{{/* Lock/unlock conversation */}}
	<button type="button" class="tw-mt-1 fluid ui show-modal button{{if .Issue.IsLocked}} red{{end}}" data-modal="#lock-conversation">
		{{if .Issue.IsLocked}}
			{{svg "octicon-key"}} {{ctx.Locale.Tr "repo.issues.unlock"}}
		{{else}}
			{{svg "octicon-lock"}} {{ctx.Locale.Tr "repo.issues.lock"}}
		{{end}}
	</button>
	<dialog class="modal-dialog" id="lock-conversation">
		<div class="header">
			{{if .Issue.IsLocked}}
				{{ctx.Locale.Tr "repo.issues.unlock.title"}}
			{{else}}
				{{ctx.Locale.Tr "repo.issues.lock.title"}}
			{{end}}
		</div>
		<div class="content">
			<div class="ui warning message">
				{{if .Issue.IsLocked}}
					{{ctx.Locale.Tr "repo.issues.unlock.notice_1"}}<br>
					{{ctx.Locale.Tr "repo.issues.unlock.notice_2"}}<br>
				{{else}}
					{{ctx.Locale.Tr "repo.issues.lock.notice_1"}}<br>
					{{ctx.Locale.Tr "repo.issues.lock.notice_2"}}<br>
					{{ctx.Locale.Tr "repo.issues.lock.notice_3"}}<br>
				{{end}}
			</div>

			<form class="ui form form-fetch-action" method="post" action="{{.Issue.Link}}{{if .Issue.IsLocked}}/unlock{{else}}/lock{{end}}">

				{{if not .Issue.IsLocked}}
					<div class="field">
						<strong>{{ctx.Locale.Tr "repo.issues.lock.reason"}}</strong>
					</div>

					<div class="field">
						<div class="ui fluid dropdown selection">
							<input type="hidden" name="reason">
							<div class="text"></div> {{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<div class="menu">
								<div class="item" data-value=""></div>
								{{range .LockReasons}}
									<div class="item" data-value="{{.}}">{{.}}</div>
								{{end}}
							</div>
						</div>
					</div>
				{{end}}

				<div class="actions">
					<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
					{{/* explicitly focus the submit button, otherwise the modal focuses and pops up the dropdown */}}
					<button type="submit" class="ui red button" autofocus>
						{{if .Issue.IsLocked}}
							{{ctx.Locale.Tr "repo.issues.unlock_confirm"}}
						{{else}}
							{{ctx.Locale.Tr "repo.issues.lock_confirm"}}
						{{end}}
					</button>
				</div>
			</form>
		</div>
	</dialog>
	{{if not .Issue.IsPull}}
		<button type="button" class="tw-mt-1 fluid ui show-modal button" data-modal="#sidebar-move-copy-issue">
			{{svg "octicon-arrow-switch"}}
			{{ctx.Locale.Tr "repo.issues.move_copy.button"}}
		</button>
		<dialog class="modal-dialog" id="sidebar-move-copy-issue">
			<div class="header">{{ctx.Locale.Tr "repo.issues.move_copy.title"}}</div>
			<form class="ui form form-fetch-action" method="post" action="{{.Issue.Link}}/move" data-move-url="{{.Issue.Link}}/move" data-copy-url="{{.Issue.Link}}/copy">
				<div class="content">
					<div class="inline fields">
						<div class="field">
							<div class="ui radio checkbox">
								<input type="radio" name="mode" value="move" checked>
								<label>{{ctx.Locale.Tr "repo.issues.move_copy.move"}}</label>
							</div>
						</div>
						<div class="field">
							<div class="ui radio checkbox">
								<input type="radio" name="mode" value="copy">
								<label>{{ctx.Locale.Tr "repo.issues.move_copy.copy"}}</label>
							</div>
						</div>
					</div>
					<p class="help" data-move-copy-mode="move">{{ctx.Locale.Tr "repo.issues.move_copy.move_desc"}}</p>
					<p class="help tw-hidden" data-move-copy-mode="copy">{{ctx.Locale.Tr "repo.issues.move_copy.copy_desc"}}</p>
					<div class="required field">
						<label>{{ctx.Locale.Tr "repo.issues.move_copy.target"}}</label>
						<div class="ui fluid search selection dropdown" data-search-url="{{.RepoLink}}/issues/move-targets?q={query}">
							<input type="hidden" name="target_repo" required>
							<div class="default text">{{ctx.Locale.Tr "repo.issues.move_copy.search"}}</div>
							<div class="menu"></div>
						</div>
					</div>
					<div class="field">
						<div class="ui checkbox">
							<input type="checkbox" name="keep_labels">
							<label>{{ctx.Locale.Tr "repo.issues.move_copy.keep_labels"}}</label>
						</div>
					</div>
					<div class="field">
						<div class="ui checkbox">
							<input type="checkbox" name="keep_milestone">
							<label>{{ctx.Locale.Tr "repo.issues.move_copy.keep_milestone"}}</label>
						</div>
					</div>
					<div class="field">
						<div class="ui checkbox">
							<input type="checkbox" name="keep_projects">
							<label>{{ctx.Locale.Tr "repo.issues.move_copy.keep_projects"}}</label>
						</div>
					</div>
					<div class="tw-hidden" data-move-copy-mode="copy">
						<div class="field">
							<div class="ui checkbox">
								<input type="checkbox" name="copy_attachments">
								<label>{{ctx.Locale.Tr "repo.issues.move_copy.copy_attachments"}}</label>
							</div>
						</div>
						<div class="field">
							<div class="ui checkbox">
								<input type="checkbox" name="copy_assignees">
								<label>{{ctx.Locale.Tr "repo.issues.move_copy.copy_assignees"}}</label>
							</div>
						</div>
						{{if and .AllowCrossRepositoryDependencies (.Repository.IsDependenciesEnabled ctx)}}
							<div class="grouped fields">
								<label>{{ctx.Locale.Tr "repo.issues.move_copy.dependency"}}</label>
								<div class="field">
									<div class="ui radio checkbox">
										<input type="radio" name="dependency" value="" checked>
										<label>{{ctx.Locale.Tr "repo.issues.move_copy.dependency_none"}}</label>
									</div>
								</div>
								<div class="field">
									<div class="ui radio checkbox">
										<input type="radio" name="dependency" value="original_blocks_copy">
										<label>{{ctx.Locale.Tr "repo.issues.move_copy.dependency_original_blocks_copy"}}</label>
									</div>
								</div>
								<div class="field">
									<div class="ui radio checkbox">
										<input type="radio" name="dependency" value="copy_blocks_original">
										<label>{{ctx.Locale.Tr "repo.issues.move_copy.dependency_copy_blocks_original"}}</label>
									</div>
								</div>
							</div>
						{{end}}
					</div>
				</div>
				{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
			</form>
		</dialog>
	{{end}}
	<button type="button" class="tw-mt-1 fluid ui show-modal button" data-modal="#sidebar-delete-issue">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.issues.delete"}}
	</button>
	<dialog class="modal-dialog" id="sidebar-delete-issue">
		<div class="header">
			{{if .Issue.IsPull}}
				{{ctx.Locale.Tr "repo.pulls.delete.title"}}
			{{else}}
				{{ctx.Locale.Tr "repo.issues.delete.title"}}
			{{end}}
		</div>
		<div class="content">
			<p>
				{{if .Issue.IsPull}}
					{{ctx.Locale.Tr "repo.pulls.delete.text"}}
				{{else}}
					{{ctx.Locale.Tr "repo.issues.delete.text"}}
				{{end}}
			</p>
		</div>
		<form action="{{.Issue.Link}}/delete" method="post">
			{{template "base/modal_actions_confirm" .}}
		</form>
	</dialog>
{{end}}
