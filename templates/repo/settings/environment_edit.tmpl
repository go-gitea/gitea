{{template "repo/settings/layout_head" (dict "pageClass" "repository settings environments")}}
	<div class="repo-setting-content">
		<h4 class="ui top attached header">{{.Environment.Name}}</h4>
		<div class="ui attached segment">
			<form class="ui form" action="{{.Link}}" method="post">
				{{.CsrfTokenHtml}}
				<div class="field">
					<label for="allowed-branch-patterns">{{ctx.Locale.Tr "environments.allowed_branch_patterns"}}</label>
					<textarea
						id="allowed-branch-patterns"
						name="allowed_branch_patterns"
						rows="4"
						placeholder="{{ctx.Locale.Tr "environments.allowed_branch_patterns_placeholder"}}"
					>{{StringUtils.Join .Environment.BranchPatterns "\n"}}</textarea>
					<p class="help">{{ctx.Locale.Tr "environments.allowed_branch_patterns_help"}}</p>
				</div>
				<button type="submit" class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
			</form>
		</div>

		{{template "shared/secrets/add_list" (dict
			"Link" (print .Link "/secrets")
			"Secrets" .Secrets
			"DataMaxLength" .DataMaxLength
			"DescriptionMaxLength" .DescriptionMaxLength
		)}}

		{{template "shared/variables/variable_list" (dict
			"Link" (print .Link "/variables")
			"Variables" .Variables
			"DataMaxLength" .DataMaxLength
			"DescriptionMaxLength" .DescriptionMaxLength
		)}}

		<h4 class="ui top attached error header">{{ctx.Locale.Tr "repo.settings.danger_zone"}}</h4>
		<div class="ui attached error danger segment">
			<div class="flex-divided-list items-with-main">
				<div class="item tw-items-center">
					<div class="item-main">
						<div class="item-title">{{ctx.Locale.Tr "environments.deletion"}}</div>
						<div class="item-body">{{ctx.Locale.Tr "environments.deletion.desc"}}</div>
					</div>
					<div class="item-trailing">
						<button type="button" class="ui basic red button link-action"
							data-url="{{.Link}}/delete"
							data-modal-confirm="{{ctx.Locale.Tr "environments.deletion.description"}}"
						>
							{{ctx.Locale.Tr "environments.deletion"}}
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
{{template "repo/settings/layout_footer" .}}
