{{template "repo/settings/layout_head" (dict "pageClass" "repository settings")}}
	<div class="repo-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "repo.settings.deploy_keys"}}
			<div class="ui right">
			{{if not .DisableSSH}}
				<button class="ui primary tiny show-panel toggle button" data-panel="#add-deploy-key-panel">{{ctx.Locale.Tr "repo.settings.add_deploy_key"}}</button>
			{{else}}
				<button class="ui primary tiny button disabled">{{ctx.Locale.Tr "settings.ssh_disabled"}}</button>
			{{end}}
			</div>
		</h4>
		<div class="ui attached segment">
			<div class="tw-hidden tw-mb-4" id="add-deploy-key-panel">
				<form class="ui form form-fetch-action" action="{{.Link}}" method="post">
					<div class="field">
						{{ctx.Locale.Tr "repo.settings.deploy_key_desc"}}
					</div>
					<div class="field">
						<label for="ssh-key-title">{{ctx.Locale.Tr "repo.settings.title"}}</label>
						<input id="ssh-key-title" name="title" value="{{.title}}" autofocus required>
					</div>
					<div class="field">
						<label for="ssh-key-content">{{ctx.Locale.Tr "repo.settings.deploy_key_content"}}</label>
						<textarea id="ssh-key-content" name="content" placeholder="{{ctx.Locale.Tr "settings.key_content_ssh_placeholder"}}" required>{{.content}}</textarea>
					</div>
					<div class="field">
						<div class="ui checkbox">
							<input id="ssh-key-is-writable" name="is_writable" type="checkbox" value="1">
							<label for="ssh-key-is-writable">
								{{ctx.Locale.Tr "repo.settings.is_writable"}}
							</label>
							<small class="tw-pl-[26px]">{{ctx.Locale.Tr "repo.settings.is_writable_info"}}</small>
						</div>
					</div>
					<button class="ui primary button">
						{{ctx.Locale.Tr "repo.settings.add_deploy_key"}}
					</button>
					<button class="ui hide-panel button" data-panel="#add-deploy-key-panel">
						{{ctx.Locale.Tr "cancel"}}
					</button>
				</form>
			</div>
			{{template "repo/settings/deploy_key_list" dict "Keys" .RepoDeployKeys "Link" .Link "IsToken" false}}
		</div>
	</div>

<div class="ui small modal" id="repo-deploy-key-delete-modal">
	<div class="header">{{svg "octicon-trash"}} {{ctx.Locale.Tr "repo.settings.deploy_key_deletion"}}</div>
	<div class="content"><p>{{ctx.Locale.Tr "repo.settings.deploy_key_deletion_desc"}}</p></div>
	{{template "base/modal_actions_confirm" .}}
</div>

	<div class="repo-setting-content tw-mt-4">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "repo.settings.deploy_tokens"}}
			<div class="ui right">
				<button class="ui primary tiny show-panel toggle button" data-panel="#add-deploy-token-panel">{{ctx.Locale.Tr "repo.settings.generate_deploy_token"}}</button>
			</div>
		</h4>
		<div class="ui attached segment">
			<div class="tw-hidden tw-mb-4" id="add-deploy-token-panel">
				<form class="ui form form-fetch-action" action="{{.Link}}/tokens" method="post">
					<div class="field">
						{{ctx.Locale.Tr "repo.settings.deploy_token_desc"}}
					</div>
					<div class="field">
						<label for="deploy-token-title">{{ctx.Locale.Tr "repo.settings.title"}}</label>
						<input id="deploy-token-title" name="title" autofocus required>
					</div>
					<div class="field">
						<div class="ui checkbox">
							<input id="deploy-token-is-writable" name="is_writable" type="checkbox" value="1">
							<label for="deploy-token-is-writable">
								{{ctx.Locale.Tr "repo.settings.is_writable"}}
							</label>
							<small class="tw-pl-[26px]">{{ctx.Locale.Tr "repo.settings.is_writable_info"}}</small>
						</div>
					</div>
					<button class="ui primary button">
						{{ctx.Locale.Tr "repo.settings.generate_deploy_token"}}
					</button>
					<button class="ui hide-panel button" data-panel="#add-deploy-token-panel">
						{{ctx.Locale.Tr "cancel"}}
					</button>
				</form>
			</div>
			{{template "repo/settings/deploy_key_list" dict "Keys" .DeployTokens "Link" .Link "IsToken" true}}
		</div>
	</div>

<div class="ui small modal" id="repo-deploy-token-delete-modal">
	<div class="header">{{svg "octicon-trash"}} {{ctx.Locale.Tr "repo.settings.deploy_token_deletion"}}</div>
	<div class="content"><p>{{ctx.Locale.Tr "repo.settings.deploy_token_deletion_desc"}}</p></div>
	{{template "base/modal_actions_confirm" .}}
</div>

<div class="ui small modal" id="repo-deploy-token-regenerate-modal">
	<div class="header">{{svg "octicon-sync"}} {{ctx.Locale.Tr "repo.settings.regenerate_deploy_token"}}</div>
	<div class="content"><p>{{ctx.Locale.Tr "repo.settings.regenerate_deploy_token_desc"}}</p></div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{template "repo/settings/layout_footer" .}}
