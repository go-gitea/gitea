{{template "repo/settings/layout_head" (dict "pageClass" "repository settings pages versions")}}
<div class="repo-setting-content" data-global-init="initRepoPagesVersions">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "repo.settings.pages.versions.title"}} ({{ctx.Locale.Tr "admin.total" .Total}})
		{{if not .Repository.IsArchived}}
			<div class="ui right">
				<form method="post" data-pages-upload>
					<input type="hidden" name="action" value="upload">
					{{template "repo/upload" dict "UploadOptions" $.UploadOptions}}
				</form>
			</div>
		{{end}}
	</h4>
	<table class="ui attached segment single line table">
		<thead>
			<tr>
				<th>{{ctx.Locale.Tr "repo.settings.pages.versions.version"}}</th>
				<th>{{ctx.Locale.Tr "repo.settings.pages.versions.origin"}}</th>
				<th>{{ctx.Locale.Tr "repo.settings.pages.versions.created"}}</th>
				<th class="collapsing tw-text-right">{{ctx.Locale.Tr "admin.notices.op"}}</th>
			</tr>
		</thead>
		<tbody>
			{{range $version := .PagesVersions}}
				<tr>
					<td>
						<span class="ui label commit-id-short tw-font-mono" title="{{$version.Digest}}">{{$version.ShortDigest}}</span>
						<button type="button" class="btn interact-fg tw-px-1" aria-label="{{ctx.Locale.Tr "copy"}}" data-clipboard-text="{{$version.Digest}}" data-tooltip-content="{{ctx.Locale.Tr "copy"}}">{{svg "octicon-copy" 14}}</button>
						{{if $version.Current}}<span class="ui basic primary label">{{ctx.Locale.Tr "repo.settings.pages.versions.current"}}</span>{{end}}
					</td>
					<td>{{if $version.OriginURL}}<a href="{{$version.OriginURL}}">{{$version.Origin}}</a>{{else}}{{$version.Origin}}{{end}}</td>
					<td>{{DateUtils.TimeSince $version.CreatedUnix}}</td>
					<td class="collapsing tw-text-right">
						{{if or $version.Current (not $.Repository.IsArchived)}}
							<div class="flex-text-block tw-flex-nowrap tw-justify-end">
								{{if $version.Current}}
									<button type="button" class="ui basic tiny compact icon button show-modal" aria-label="{{ctx.Locale.Tr "repo.settings.pages.versions.details"}}" data-tooltip-content="{{ctx.Locale.Tr "repo.settings.pages.versions.details"}}" data-modal="#pages-current-deployment-modal">{{svg "octicon-info"}}</button>
								{{else if not $.Repository.IsArchived}}
									<button type="button" class="ui basic tiny compact icon button link-action" aria-label="{{ctx.Locale.Tr "repo.settings.pages.versions.restore"}}" data-tooltip-content="{{ctx.Locale.Tr "repo.settings.pages.versions.restore"}}" data-url="{{$.RepoLink}}/settings/pages/versions?action=restore-version&amp;version_id={{$version.ID}}" data-fetch-sync="$body" data-modal-confirm-header="{{ctx.Locale.Tr "repo.settings.pages.versions.restore_confirm"}}" data-modal-confirm-content="{{ctx.Locale.Tr "repo.settings.pages.versions.restore_confirm_desc" $version.ShortDigest}}">{{svg "octicon-reply"}}</button>
								{{end}}
								{{if not $.Repository.IsArchived}}
									<button type="button" class="ui basic tiny compact red icon button link-action negative" aria-label="{{ctx.Locale.Tr "repo.settings.pages.versions.delete"}}" data-tooltip-content="{{ctx.Locale.Tr "repo.settings.pages.versions.delete"}}" data-url="{{$.RepoLink}}/settings/pages/versions?action=delete-version&amp;version_id={{$version.ID}}" data-fetch-sync="$body" data-modal-confirm-header="{{ctx.Locale.Tr "repo.settings.pages.versions.delete_confirm"}}" data-modal-confirm-content="{{if $version.Current}}{{ctx.Locale.Tr "repo.settings.pages.versions.delete_current_confirm_desc" $version.ShortDigest}}{{else}}{{ctx.Locale.Tr "repo.settings.pages.versions.delete_confirm_desc" $version.ShortDigest}}{{end}}">{{svg "octicon-trash"}}</button>
								{{end}}
							</div>
						{{end}}
					</td>
				</tr>
			{{else}}
				<tr><td colspan="4">{{ctx.Locale.Tr "repo.settings.pages.versions.empty"}}</td></tr>
			{{end}}
		</tbody>
	</table>
	{{template "base/paginate" .}}
</div>
{{if .PagesCurrentDeployment}}
	<dialog class="modal-dialog" id="pages-current-deployment-modal">
		<div class="header">{{ctx.Locale.Tr "repo.settings.pages.versions.deployment.title"}}</div>
		<div class="content">
			<div class="flex-text-block">
				{{template "repo/icons/action_status" (dict "Status" .PagesCurrentDeployment.Status "IconVariant" "circle-fill")}}
				<strong>{{.PagesCurrentDeployment.StatusText}}</strong>
			</div>
			{{if .PagesCurrentDeployment.Instances}}
				<div class="flex-divided-list items-with-main tw-mt-4">
					{{range $instance := .PagesCurrentDeployment.Instances}}
						<div class="item">
							<div class="item-main">
								<div class="item-title tw-break-anywhere">{{$instance.RootURL}}</div>
								<div class="item-body tw-flex-col tw-items-start">
									<div class="flex-text-block">
										{{template "repo/icons/action_status" (dict "Status" $instance.Default.Status)}}
										<strong>{{ctx.Locale.Tr "repo.settings.pages.versions.deployment.default"}}</strong>
										<a class="tw-break-anywhere" href="{{$instance.Default.URL}}" target="_blank" rel="noopener noreferrer">{{$instance.Default.URL}}</a>
										<span class="tw-text-text-light">{{$instance.Default.StatusText}}</span>
									</div>
									{{if $instance.Custom.URL}}
										<div class="flex-text-block tw-mt-1">
											{{template "repo/icons/action_status" (dict "Status" $instance.Custom.Status)}}
											<strong>{{ctx.Locale.Tr "repo.settings.pages.versions.deployment.custom"}}</strong>
											<a class="tw-break-anywhere" href="{{$instance.Custom.URL}}" target="_blank" rel="noopener noreferrer">{{$instance.Custom.URL}}</a>
											<span class="tw-text-text-light">{{$instance.Custom.StatusText}}</span>
										</div>
									{{end}}
									{{if $instance.Error}}<div class="tw-mt-2 tw-text-red">{{$instance.Error}}</div>{{end}}
								</div>
							</div>
						</div>
					{{end}}
				</div>
			{{end}}
		</div>
		<div class="actions">
			<button type="button" class="ui cancel button">{{ctx.Locale.Tr "close"}}</button>
		</div>
	</dialog>
{{end}}
{{template "repo/settings/layout_footer" .}}
