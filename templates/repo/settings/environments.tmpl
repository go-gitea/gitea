{{template "repo/settings/layout_head" (dict "pageClass" "repository settings environments")}}
	<div class="repo-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "environments.environments"}}
			<div class="ui right">
				<button type="button" class="ui primary tiny button show-modal" data-modal="#new-environment-modal">
					{{ctx.Locale.Tr "environments.new"}}
				</button>
			</div>
		</h4>
		<div class="ui attached segment">
			{{if .Environments}}
			<div class="flex-divided-list items-with-main">
				{{range $env := .Environments}}
				{{$envLink := $env.SettingsLink $.RepoLink}}
				<div class="item tw-items-center">
					<div class="item-leading">{{svg "octicon-server" 32}}</div>
					<div class="item-main">
						<div class="item-title">
							<a href="{{$envLink}}">{{$env.Name}}</a>
						</div>
						<div class="item-body">
							{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort $env.CreatedUnix)}}
							{{if $env.AllowedBranchPatterns}}·{{svg "octicon-git-branch" 14}} {{StringUtils.Join $env.BranchPatterns ", "}}{{end}}
						</div>
					</div>
					<div class="item-trailing">
						<a class="btn interact-bg tw-p-2 silenced"
							href="{{$envLink}}"
							data-tooltip-content="{{ctx.Locale.Tr "environments.configure"}}"
						>
							{{svg "octicon-pencil"}}
						</a>
						<button type="button" class="btn interact-bg tw-p-2 link-action"
							data-url="{{$envLink}}/delete"
							data-modal-confirm="{{ctx.Locale.Tr "environments.deletion.description"}}"
							data-tooltip-content="{{ctx.Locale.Tr "environments.deletion"}}"
						>
							{{svg "octicon-trash"}}
						</button>
					</div>
				</div>
				{{end}}
			</div>
			{{else}}
				{{ctx.Locale.Tr "environments.none"}}
			{{end}}
		</div>
	</div>

<dialog class="modal-dialog" id="new-environment-modal">
	<div class="header">{{ctx.Locale.Tr "environments.new"}}</div>
	<form class="ui form form-fetch-action" action="{{.Link}}" method="post">
		<div class="content">
			<div class="field">
				<label>{{ctx.Locale.Tr "name"}}</label>
				<input autofocus required
					name="name"
					maxlength="{{.EnvironmentNameMaxLength}}"
					placeholder="{{ctx.Locale.Tr "environments.name_placeholder"}}"
				>
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "environments.allowed_branch_patterns"}}</label>
				<textarea
					name="allowed_branch_patterns"
					rows="3"
					placeholder="{{ctx.Locale.Tr "environments.allowed_branch_patterns_placeholder"}}"
				></textarea>
				<p class="help">{{ctx.Locale.Tr "environments.allowed_branch_patterns_help"}}</p>
			</div>
		</div>
		{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
	</form>
</dialog>
{{template "repo/settings/layout_footer" .}}
