<div class="dropdown-container" data-kind="multiselect">
	<input type="hidden" class="dropdown-value" name="{{.Name}}" value="{{.Value}}">
	<div class="dropdown-trigger dropdown-field dropdown-search-field">
		<input class="dropdown-filter" type="text">
		<span class="dropdown-text" data-placeholder="{{ctx.Locale.Tr "search.team_kind"}}">{{ctx.Locale.Tr "search.team_kind"}}</span>
	</div>
	<div class="dropdown-popup">
		{{range .Teams}}
			<div class="dropdown-item" data-value="{{.ID}}">
				{{svg "octicon-people"}}
				{{.Name}}
			</div>
		{{end}}
	</div>
</div>
