{{$selectedIDs := StringUtils.Split (or .Value "") ","}}
{{$selectedNames := ""}}
{{range .Teams}}
	{{if SliceUtils.Contains $selectedIDs (StringUtils.ToString .ID)}}
		{{$selectedNames = print $selectedNames (Iif $selectedNames ", " "") .Name}}
	{{end}}
{{end}}
<div class="dropdown-container" data-kind="multiselect">
	<input type="hidden" class="dropdown-value" name="{{.Name}}" value="{{.Value}}">
	<button type="button" class="dropdown-trigger dropdown-field">
		<span class="dropdown-text" data-placeholder="{{ctx.Locale.Tr "search.team_kind"}}">{{or $selectedNames (ctx.Locale.Tr "search.team_kind")}}</span>
		{{svg "octicon-triangle-down" 14}}
	</button>
	<div class="dropdown-popup">
		<input class="dropdown-filter" type="search" placeholder="{{ctx.Locale.Tr "search.team_kind"}}">
		{{range .Teams}}
			<div class="dropdown-item" data-value="{{.ID}}" data-text="{{.Name}}">
				{{svg "octicon-people"}}
				{{.Name}}
			</div>
		{{end}}
	</div>
</div>
