{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository security">
	{{template "repo/header" .}}
	<div class="ui container">
		<h2 class="ui dividing header">{{ctx.Locale.Tr "repo.security.new_disclosure"}}</h2>
		{{template "base/alert" .}}
		<form class="ui form" method="post" action="{{.RepoLink}}/security/disclosures/new">
			<div class="field {{if .Err_Title}}error{{end}}">
				<label for="disclosure-title">{{ctx.Locale.Tr "repo.security.title"}}</label>
				<input id="disclosure-title" name="title" value="{{.title}}" required maxlength="255" autofocus>
			</div>
			<div class="field">
				<label for="disclosure-summary">{{ctx.Locale.Tr "repo.security.summary"}}</label>
				<input id="disclosure-summary" name="summary" value="{{.summary}}" maxlength="4096" placeholder="{{ctx.Locale.Tr "repo.security.summary_placeholder"}}">
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "repo.security.description"}}</label>
				{{$markdownEditorContext := ctx.MiscUtils.MarkdownEditorComment $.Repository}}
				{{template "shared/combomarkdowneditor" (dict
					"MarkdownEditorContext" $markdownEditorContext
					"TextareaName" "content"
					"TextareaContent" .content
					"TextareaPlaceholder" (ctx.Locale.Tr "repo.security.description_placeholder")
				)}}
			</div>
			<div class="field">
				<label for="disclosure-severity">{{ctx.Locale.Tr "repo.security.severity"}}</label>
				<select id="disclosure-severity" class="ui selection dropdown" name="severity" required>
					{{range .AllSeverities}}
						<option value="{{.}}" {{if eq (printf "%s" .) "moderate"}}selected{{end}}>{{ctx.Locale.Tr (print "repo.security.severity_" .)}}</option>
					{{end}}
				</select>
			</div>
			<div class="field">
				<label for="disclosure-cvss">{{ctx.Locale.Tr "repo.security.cvss_vector"}}</label>
				<input id="disclosure-cvss" name="cvss_vector" value="{{.cvss_vector}}" maxlength="128" placeholder="CVSS:3.1/AV:N/...">
				<p class="help">{{ctx.Locale.Tr "repo.security.cvss_vector_help"}}</p>
			</div>
			<div class="field">
				<label for="disclosure-cweids">{{ctx.Locale.Tr "repo.security.cwe_ids"}}</label>
				<input id="disclosure-cweids" name="cwe_ids" value="{{.cwe_ids}}" placeholder="CWE-79, CWE-120">
			</div>
			<div class="field">
				<label for="disclosure-cveid">{{ctx.Locale.Tr "repo.security.cve_id"}}</label>
				<input id="disclosure-cveid" name="cve_id" value="{{.cve_id}}" maxlength="64" placeholder="CVE-2026-0000">
			</div>
			<div class="field">
				<label for="disclosure-references">{{ctx.Locale.Tr "repo.security.references"}}</label>
				<textarea id="disclosure-references" name="references" rows="2" placeholder="{{ctx.Locale.Tr "repo.security.references_placeholder"}}">{{.references}}</textarea>
			</div>
			<div class="field">
				<label for="disclosure-affected">{{ctx.Locale.Tr "repo.security.affected_versions"}}</label>
				<textarea id="disclosure-affected" name="affected_versions" rows="2" placeholder="{{ctx.Locale.Tr "repo.security.versions_placeholder"}}">{{.affected_versions}}</textarea>
				<p class="help">{{ctx.Locale.Tr "repo.security.affected_versions_help"}}</p>
			</div>
			<div class="field">
				<label for="disclosure-fixed">{{ctx.Locale.Tr "repo.security.fixed_versions"}}</label>
				<textarea id="disclosure-fixed" name="fixed_versions" rows="2" placeholder="{{ctx.Locale.Tr "repo.security.versions_placeholder"}}">{{.fixed_versions}}</textarea>
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input id="disclosure-publish" name="publish" type="checkbox" {{if .publish}}checked{{end}}>
					<label for="disclosure-publish">{{ctx.Locale.Tr "repo.security.publish_immediately"}}</label>
				</div>
			</div>
			<div class="field">
				<button class="ui primary button" type="submit">{{ctx.Locale.Tr "repo.security.create"}}</button>
				<a class="ui button" href="{{.RepoLink}}/security/disclosures">{{ctx.Locale.Tr "repo.security.cancel"}}</a>
			</div>
		</form>
	</div>
</div>
{{template "base/footer" .}}
