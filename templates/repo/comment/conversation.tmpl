{{if len .comments}}
	{{$root := ctx.RootData}}
	{{$firstComment := index .comments 0}}
	{{$resolved := $firstComment.IsResolved}}
	<div class="conversation-holder" data-path="{{$firstComment.TreePath}}" data-side="{{if lt $firstComment.Line 0}}left{{else}}right{{end}}" data-idx="{{$firstComment.UnsignedLine}}">
		{{if $resolved}}
			<div class="resolved-placeholder">
				<div class="flex-text-block tw-flex-wrap tw-text-text-light">
					{{svg "octicon-check"}}
					<b>{{$firstComment.ResolveDoer.Name}}</b> {{ctx.Locale.Tr "repo.issues.review.resolved_by"}}
					{{if $firstComment.Invalidated}}
						<a href="{{$root.CommentContext.ConversationURL}}#{{$firstComment.HashTag}}" class="ui label basic small tw-ml-2" data-tooltip-content="{{ctx.Locale.Tr "repo.issues.review.outdated_description"}}">
							{{ctx.Locale.Tr "repo.issues.review.outdated"}}
						</a>
					{{end}}
				</div>
				<div class="flex-text-block">
					<button type="button" id="show-outdated-{{$firstComment.ID}}" data-comment="{{$firstComment.ID}}" class="btn tiny show-outdated">
						{{svg "octicon-unfold" 16 "tw-mr-2"}}{{ctx.Locale.Tr "repo.issues.review.show_resolved"}}
					</button>
					<button type="button" id="hide-outdated-{{$firstComment.ID}}" data-comment="{{$firstComment.ID}}" class="btn tiny hide-outdated tw-hidden">
						{{svg "octicon-fold" 16 "tw-mr-2"}}{{ctx.Locale.Tr "repo.issues.review.hide_resolved"}}
					</button>
				</div>
			</div>
		{{end}}
		<div id="code-comments-{{$firstComment.ID}}" class="field comment-code-cloud {{if $resolved}}tw-hidden{{end}}">
			<div class="comment-list">
				<div class="ui comments">
					{{template "repo/comment/comments" dict "comments" .comments}}
				</div>
			</div>
			<div class="flex-text-block tw-mt-2 tw-flex-wrap tw-justify-end">
				<div class="ui buttons">
					<button type="button" class="ui icon tiny basic button previous-conversation">
						{{svg "octicon-arrow-up" 12}} {{ctx.Locale.Tr "repo.issues.previous"}}
					</button>
					<button type="button" class="ui icon tiny basic button next-conversation">
						{{svg "octicon-arrow-down" 12}} {{ctx.Locale.Tr "repo.issues.next"}}
					</button>
				</div>
				{{if and $root.CanMarkConversation $firstComment.Review (ne $firstComment.Review.Type 0)}}
					<button type="button" class="ui icon tiny basic button resolve-conversation" data-origin="diff" data-action="{{Iif $resolved "UnResolve" "Resolve"}}" data-comment-id="{{$firstComment.ID}}" data-update-url="{{$root.RepoLink}}/issues/resolve_conversation">
						{{ctx.Locale.Tr (Iif $resolved "repo.issues.review.un_resolve_conversation" "repo.issues.review.resolve_conversation")}}
					</button>
				{{end}}
				{{if $root.CommentContext.CanAddComment}}
					<button type="button" class="comment-form-reply ui primary icon tiny button">
						{{svg "octicon-reply" 12}}{{ctx.Locale.Tr "repo.diff.comment.reply"}}
					</button>
				{{end}}
			</div>
			{{template "repo/comment/form" dict "ReplyReviewComment" $firstComment}}
		</div>
	</div>
{{else}}
	{{template "repo/comment/conversation_outdated"}}
{{end}}
