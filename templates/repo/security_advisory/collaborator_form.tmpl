{{$placeholder := ctx.Locale.Tr .PlaceholderKey}}
<form class="ui form form-fetch-action" action="{{.Link}}/collaborators" method="post">
	<input type="hidden" name="type" value="{{.Type}}">
	<div class="field">
		<div class="ui search fluid input" data-global-init="{{.SearchInit}}"{{with .OrgName}} data-org-name="{{.}}"{{end}}>
			<input class="prompt" name="collaborator" placeholder="{{$placeholder}}" aria-label="{{$placeholder}}" autocomplete="off" required>
		</div>
	</div>
	<button type="submit" class="fluid ui button">{{svg .Icon}} {{ctx.Locale.Tr .SubmitKey}}</button>
</form>
