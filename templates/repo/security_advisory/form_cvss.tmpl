<div class="field security-advisory-cvss" data-cvss-prefix="{{.Prefix}}" data-preview-url="{{.PreviewLink}}">
	<label>{{.Label}}</label>
	<div class="ui segment">
		<details {{if .Vector}}open{{end}}>
			<summary>{{ctx.Locale.Tr "repo.security_advisories.cvss.calculator"}}</summary>
			<div class="flex-relaxed-list tw-mt-2">
				{{range $m := .Metrics}}
					<div class="flex-text-block tw-flex-wrap">
						<span class="tw-w-72 tw-shrink-0">{{$m.Name}}</span>
						<div class="ui small basic buttons" data-cvss-metric="{{$m.Key}}" role="group" aria-label="{{$m.Name}}">
							{{range $m.Values}}
								<button type="button" class="ui button" data-value="{{.Key}}" aria-pressed="false">{{.Name}}</button>
							{{end}}
						</div>
					</div>
				{{end}}
			</div>
			<div class="divider"></div>
		</details>
		<div class="flex-text-block">
			<div class="ui input tw-flex-1">
				<input name="{{.Name}}" class="tw-font-mono" value="{{.Vector}}" maxlength="255" placeholder="{{.Prefix}}…" aria-label="{{.Label}}">
			</div>
			<span class="ui basic label" data-cvss-result>{{ctx.Locale.Tr "repo.security_advisories.cvss.no_score"}}</span>
		</div>
	</div>
</div>
