{{template "devtest/devtest-header"}}
<div class="page-content devtest ui container repository view issue">
	<h1>Pull Merge Box</h1>
	<div class="issue-content">
		<div class="issue-content-left">
			<div class="comment-list">
				{{range $scenario := $.MergeBoxScenarios}}
					<h2>{{$scenario.ScenarioTitle}}</h2>
					{{template "repo/issue/view_content/pull_merge_box" $scenario}}
				{{end}}
			</div>
		</div>
	</div>
</div>
{{template "devtest/devtest-footer"}}
