<div class="ui container fluid">
	{{if or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn)}}
	{{template "base/alert" .}}
	{{end}}
	<h4 class="ui top attached header center">
		{{if .LinkAccountMode}}
			{{ctx.Locale.Tr "auth.oauth_signin_title"}}
		{{else}}
			{{ctx.Locale.Tr "auth.login_userpass"}}
		{{end}}
	</h4>
	<div class="ui attached segment">
		{{if .EnablePasswordSignInForm}}
		<form class="ui form" action="{{.SignInLink}}" method="post">
			<div class="required field {{if and (.Err_UserName) (or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn))}}error{{end}}">
				<label for="user_name">{{ctx.Locale.Tr "home.uname_holder"}}</label>
				<input id="user_name" type="text" name="user_name" value="{{.user_name}}" autofocus required>
			</div>
			{{if or (not .DisablePassword) .LinkAccountMode}}
			<div class="required field {{if and (.Err_Password) (or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn))}}error{{end}}">
				<label for="password">{{ctx.Locale.Tr "password"}}</label>
				<input id="password" name="password" type="password" value="{{.password}}" autocomplete="current-password" required>
			</div>
			{{end}}
			{{template "user/auth/remember_me" .}}

			{{template "user/auth/captcha" .}}

			<div class="field">
				<button type="submit" class="ui primary button tw-w-full">
					{{if .LinkAccountMode}}
						{{ctx.Locale.Tr "auth.oauth_signin_submit"}}
					{{else}}
						{{ctx.Locale.Tr "sign_in"}}
					{{end}}
				</button>
			</div>
			{{template "user/auth/signin_passkey" .}}
			{{if or (not .DisablePassword) .LinkAccountMode}}
			<div class="field tw-text-center">
				<a href="{{AppSubUrl}}/user/forgot_password">{{ctx.Locale.Tr "auth.forgot_password"}}</a>
			</div>
			{{end}}
		</form>
		{{end}}{{/*end if .EnablePasswordSignInForm*/}}
		{{$passwordFree := or .OAuth2Providers (and .EnablePasskeyAuth (not .EnablePasswordSignInForm))}}
		{{if or $passwordFree .EnableSSPI}}
			{{if .EnablePasswordSignInForm}}
			<div class="divider divider-text">{{ctx.Locale.Tr "sign_in_or"}}</div>
			{{end}}
			<form class="ui form" action="{{AppSubUrl}}/user/oauth2" method="post">
				{{if $passwordFree}}{{template "user/auth/remember_me" .}}{{end}}
				{{if not .EnablePasswordSignInForm}}{{template "user/auth/signin_passkey" .}}{{end}}
				{{template "user/auth/external_auth_methods" .}}
			</form>
		{{end}}
	</div>
</div>

{{if .ShowRegistrationButton}}
<div class="ui container fluid">
	<div class="ui segment tw-text-center">
		<span>{{ctx.Locale.Tr "auth.need_account"}}</span>
		<a href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "auth.sign_up_now"}}</a>
	</div>
</div>
{{end}}
