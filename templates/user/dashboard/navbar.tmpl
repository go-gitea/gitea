{{$teamSuffix := ""}}
{{if .Team}}{{$teamSuffix = print "/" (PathEscape .Team.Name)}}{{end}}
{{$isOverview := eq .DashboardTab "overview"}}
{{$isActivity := eq .DashboardTab "activity"}}
<div class="secondary-nav tw-border-b tw-border-b-secondary">
	<div class="dashboard-navbar">
		<div class="dashboard-navbar-links" data-global-init="initDashboardNavbarLinks">
			{{if not (and ctx.Consts.RepoUnitTypeIssues.UnitGlobalDisabled ctx.Consts.RepoUnitTypePullRequests.UnitGlobalDisabled)}}
				<a class="silenced interact-bg{{if $isOverview}} active{{end}}" {{if $isOverview}}aria-current="page"{{end}} href="{{.ContextUser.DashboardLink}}{{$teamSuffix}}" data-dashboard-tab="overview" data-global-click="onDashboardTabClick">
					{{svg "octicon-home"}}{{ctx.Locale.Tr "home.dashboard_tab_overview"}}
				</a>
			{{end}}
			<a class="silenced interact-bg{{if $isActivity}} active{{end}}" {{if $isActivity}}aria-current="page"{{end}} href="{{.ContextUser.DashboardLink}}{{$teamSuffix}}" data-dashboard-tab="activity" data-global-click="onDashboardTabClick">
				{{svg "octicon-rss"}}{{ctx.Locale.Tr "home.dashboard_tab_activity"}}
			</a>
			{{if .ContextUser.IsOrganization}}
				{{if not ctx.Consts.RepoUnitTypeIssues.UnitGlobalDisabled}}
					<a class="silenced interact-bg" href="{{.ContextUser.OrganisationLink}}/issues{{$teamSuffix}}">
						{{svg "octicon-issue-opened"}}{{ctx.Locale.Tr "issues"}}
					</a>
				{{end}}
				{{if not ctx.Consts.RepoUnitTypePullRequests.UnitGlobalDisabled}}
					<a class="silenced interact-bg" href="{{.ContextUser.OrganisationLink}}/pulls{{$teamSuffix}}">
						{{svg "octicon-git-pull-request"}}{{ctx.Locale.Tr "pull_requests"}}
					</a>
				{{end}}
				{{if and .ShowMilestonesDashboardPage (not (and ctx.Consts.RepoUnitTypeIssues.UnitGlobalDisabled ctx.Consts.RepoUnitTypePullRequests.UnitGlobalDisabled))}}
					<a class="silenced interact-bg" href="{{.ContextUser.OrganisationLink}}/milestones{{$teamSuffix}}">
						{{svg "octicon-milestone"}}{{ctx.Locale.Tr "milestones"}}
					</a>
				{{end}}
			{{end}}
		</div>
		<div class="dashboard-navbar-controls">
			{{template "user/dashboard/context_selectors" .}}
		</div>
	</div>
</div>
