{{template "user/settings/layout_head" (dict "pageClass" "user settings applications")}}
	<div class="user-setting-content">
		{{template "shared/user/access_tokens" (dict
			"Description" (ctx.Locale.Tr "settings.tokens_desc")
			"Tokens" .Tokens
			"ScopeCategories" .TokenCategories
			"ScopePublicOnly" .AccessTokenScopePublicOnly
			"CreateURL" .Link
			"DeleteURL" (print .Link "/delete")
			"RegenerateURL" (print .Link "/regenerate")
			"NameValue" .name
			"ErrName" .Err_Name
			"NewTokenValue" .NewTokenValue
		)}}

		{{if .EnableOAuth2}}
			{{template "user/settings/grants_oauth2" .}}
			{{template "user/settings/applications_oauth2" .}}
		{{end}}
	</div>

{{template "user/settings/layout_footer" .}}
