{{template "user/settings/layout_head" (dict "pageClass" "user settings")}}
	<div class="user-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "notifications"}}
		</h4>
		<div class="ui attached segment">
			<div class="ui list flex-items-block">
				<div class="item">
					<form class="ui form tw-w-full" action="{{AppSubUrl}}/user/settings/notifications/email" method="post">
						<div class="field">
							<label>{{ctx.Locale.Tr "settings.email_desc"}}</label>
							<select name="preference">
								<option value="enabled" {{if eq $.EmailNotificationsPreference "enabled"}}selected{{end}}>{{ctx.Locale.Tr "settings.email_notifications.enable"}}</option>
								<option value="andyourown" {{if eq $.EmailNotificationsPreference "andyourown"}}selected{{end}}>{{ctx.Locale.Tr "settings.email_notifications.andyourown"}}</option>
								<option value="onmention" {{if eq $.EmailNotificationsPreference "onmention"}}selected{{end}}>{{ctx.Locale.Tr "settings.email_notifications.onmention_and_custom"}}</option>
								<option value="disabled" {{if eq $.EmailNotificationsPreference "disabled"}}selected{{end}}>{{ctx.Locale.Tr "settings.email_notifications.disable"}}</option>
							</select>
						</div>
						<div class="field">
							<button type="submit" class="ui primary button">{{ctx.Locale.Tr "settings.email_notifications.submit"}}</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		{{if .EnableActions}}
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "actions.actions"}}
		</h4>
		<div class="ui attached segment">
			<div class="ui list flex-items-block">
				<div class="item">
					<form class="ui form tw-w-full" action="{{AppSubUrl}}/user/settings/notifications/actions" method="post">
						<div class="field">
							<label>{{ctx.Locale.Tr "settings.email_notifications.actions.desc" "https://docs.gitea.com/usage/actions/overview/"}}</label>
							<select name="preference">
								<option value="all" {{if eq $.ActionsEmailNotificationsPreference "all"}}selected{{end}}>{{ctx.Locale.Tr "all"}}</option>
								<option value="failure-only" {{if eq $.ActionsEmailNotificationsPreference "failure-only"}}selected{{end}}>{{ctx.Locale.Tr "settings.email_notifications.actions.failure_only"}}</option>
								<option value="disabled" {{if eq $.ActionsEmailNotificationsPreference "disabled"}}selected{{end}}>{{ctx.Locale.Tr "disabled"}}</option>
							</select>
						</div>
						<div class="field">
							<button type="submit" class="ui primary button">{{ctx.Locale.Tr "settings.email_notifications.submit"}}</button>
						</div>
					</form>
				</div>
			</div>
		</div>
		{{end}}
	</div>

{{template "user/settings/layout_footer" .}}
