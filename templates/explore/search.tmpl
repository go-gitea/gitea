<div class="ui small secondary filter menu tw-items-center tw-mx-0">
	<form class="ui form ignore-dirty tw-flex-1">
		{{if .PageIsExploreUsers}}
			{{template "shared/search/combo" dict "Value" .Keyword "Placeholder" (ctx.Locale.Tr "search.user_kind")}}
		{{else}}
			{{template "shared/search/combo" dict "Value" .Keyword "Placeholder" (ctx.Locale.Tr "search.org_kind")}}
		{{end}}
	</form>
	<!-- Sort -->
	<div class="dropdown-container">
		<button type="button" class="dropdown-trigger item tw-mr-0">{{ctx.Locale.Tr "repo.issues.filter_sort"}} {{svg "octicon-triangle-down" 14}}</button>
		<div class="dropdown-popup dropdown-popup-small">
			<a class="{{if eq .SortType "newest"}}active {{end}}dropdown-item" href="?sort=newest&q={{$.Keyword}}">{{ctx.Locale.Tr "repo.issues.filter_sort.latest"}}</a>
			<a class="{{if eq .SortType "oldest"}}active {{end}}dropdown-item" href="?sort=oldest&q={{$.Keyword}}">{{ctx.Locale.Tr "repo.issues.filter_sort.oldest"}}</a>
			<a class="{{if eq .SortType "alphabetically"}}active {{end}}dropdown-item" href="?sort=alphabetically&q={{$.Keyword}}">{{ctx.Locale.Tr "repo.issues.label.filter_sort.alphabetically"}}</a>
			<a class="{{if eq .SortType "reversealphabetically"}}active {{end}}dropdown-item" href="?sort=reversealphabetically&q={{$.Keyword}}">{{ctx.Locale.Tr "repo.issues.label.filter_sort.reverse_alphabetically"}}</a>
		</div>
	</div>
</div>
<div class="divider"></div>
